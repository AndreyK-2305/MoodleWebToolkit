    [[ $2 =~ ^[a-z][a-z0-9]*_[a-z][a-z0-9_]{0,60}$ ]] || fail invalid_arguments
    load_destination "$1"
    local file="$DST_RUNTIME_DIR/exports/plugin-proposals/$2.json"
    [[ -f $file && ! -L $file ]] || fail plugin_proposal_missing
    (($(stat -c %s "$file") <= 8192)) || fail plugin_proposal_invalid
    respond_ok plugin-proposal "{\"destination\":\"$1\",\"component\":\"$2\",\"proposal_base64\":\"$(base64 -w0 <"$file")\"}"
}

cmd_consolidator_intervention() {
    (($# == 2)) || fail invalid_arguments
    local runtime kind=$2 name entries='' sep='' file
    load_destination "$1"
    runtime=$DST_RUNTIME_DIR
    [[ -d $runtime && ! -L $runtime && ! -L $runtime/reports && ! -L $runtime/exports ]] || fail destination_runtime_missing
    local -a documents
    case $kind in
        oauth2) documents=(oauth2_manual=reports/oauth2-configuracion-manual.txt oauth2_validation=exports/oauth2/validation.json
            oauth2_live=exports/oauth2-live/validation.json) ;;
        plugins) documents=(plugin_needs=exports/phase2/plugin_compatibility_needs.json plugin_diff=exports/phase2/plugin_inventory_diff.json
            plugin_technical=exports/phase2/plugin_technical_validation.json plugin_checkpoint=exports/phase2/plugin_intervention_checkpoint.json
            plugin_lock=exports/plugin-lock.json) ;;
        *) fail invalid_arguments ;;
    esac
    for name in "${documents[@]}"; do
        file="$runtime/${name#*=}"
