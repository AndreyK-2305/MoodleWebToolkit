#!/usr/bin/env bash
# MoodleWebToolkit remote agent.
#
# Installed by the platform on a source or destination server. It accepts a
# closed set of subcommands, prints exactly one JSON document per invocation
# and never runs arbitrary commands: only the operations registered below.
# Long operations run as transient systemd units, so they survive the loss of
# the SSM/SSH session that launched them; the platform reconnects and reads
# their durable state files.
set -euo pipefail
umask 077

readonly AGENT_VERSION="1.17.1"
readonly SCHEMA="mwt-agent.v1"
readonly STATE_DIR="${MWT_AGENT_STATE_DIR:-/var/lib/mwt-agent}"
readonly OPS_DIR="${STATE_DIR}/ops"
readonly STAGING_DIR="${STATE_DIR}/staging"
readonly TOOLS_DIR="${MWT_AGENT_TOOLS_DIR:-/opt/mwt-agent/tools}"
# Source profiles: written by the server's administrator with mwt-source-profile or, from 1.17.0,
# by source-profile-create once a platform administrator confirms them. Always root:root 0600.
readonly SOURCES_DIR="${MWT_AGENT_SOURCES_DIR:-/etc/mwt-agent/sources}"
# Destination profiles too: each names the Consolidator runtime prepared for it.
readonly DESTINATIONS_DIR="${MWT_AGENT_DESTINATIONS_DIR:-/etc/mwt-agent/destinations}"
# Where moodle-detect looks for native installations (space-separated absolute directories).
readonly DETECT_ROOTS="${MWT_AGENT_DETECT_ROOTS:-/var/www /opt /srv}"
readonly CONSOLIDATOR_COMPOSE_PROJECT="moodle-consolidation-production"
readonly HTTPS_URL_RE='^https://[A-Za-z0-9._:-]+(/[A-Za-z0-9._~/-]*)?$'
readonly COLLECTOR_TOOL_KEY="moodle-recolector-7.4.2-linux-tree"
readonly TOOL_KEY_RE='^[a-z0-9][a-z0-9.-]{2,80}$'
readonly SHA_RE='^[0-9a-f]{64}$'
readonly SOURCE_RE='^[a-z0-9][a-z0-9-]{1,62}$'
readonly PATH_RE='^/[A-Za-z0-9._/-]{1,255}$'
readonly USER_RE='^[a-z_][a-z0-9_-]{0,31}$'
readonly SERVICE_RE='^[a-z0-9][a-z0-9_-]{0,62}$'
readonly EMAIL_RE='^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
readonly BUCKET_RE='^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$'
readonly REGION_RE='^[a-z]{2}(-gov)?-[a-z]+-[1-9]$'
readonly MAX_TAIL_BYTES=16384
readonly HEARTBEAT_SECONDS=10
readonly SELF_PATH=$(readlink -f "${BASH_SOURCE[0]}")
readonly PLUGIN_INSPECT_PHP=$(cat <<'MWT_PHP'
// Inspects a plugin for the Consolidator's catalog: the pinned commit, its version.php and its
// tree, with the catalog's own functions. Writes a proposal; nothing is installed here.
require getcwd() . "/scripts/v8-plugin-catalog.php";
[, $component, $repository, $commit] = $argv;
$dirs = ["mod" => "mod", "block" => "blocks", "local" => "local", "theme" => "theme", "auth" => "auth", "enrol" => "enrol",
    "filter" => "filter", "format" => "course/format", "qtype" => "question/type", "qbehaviour" => "question/behaviour",
    "report" => "report", "tool" => "admin/tool", "atto" => "lib/editor/atto/plugins", "tiny" => "lib/editor/tiny/plugins",
    "availability" => "availability/condition", "assignsubmission" => "mod/assign/submission", "assignfeedback" => "mod/assign/feedback",
    "gradeexport" => "grade/export", "gradeimport" => "grade/import", "gradereport" => "grade/report", "repository" => "repository",
    "plagiarism" => "plagiarism", "customfield" => "customfield/field", "profilefield" => "user/profile/field",
    "quiz" => "mod/quiz/report", "quizaccess" => "mod/quiz/accessrule", "datafield" => "mod/data/field", "booktool" => "mod/book/tool",
    "message" => "message/output", "media" => "media/player", "contenttype" => "contentbank/contenttype", "paygw" => "payment/gateway",
    "editor" => "lib/editor", "logstore" => "admin/tool/log/store", "workshopform" => "mod/workshop/form"];
[$type, $name] = explode("_", $component, 2);
if (!isset($dirs[$type])) { fwrite(STDERR, "PLUGIN_TYPE_UNSUPPORTED: $type\n"); exit(71); }
$work = getcwd() . "/cache/plugin-inspect/" . $component;
if (is_dir($work)) { v8c_delete_tree($work); }
@mkdir(dirname($work), 0775, true);
try {
    v8c_process(["git", "clone", "--no-checkout", $repository, $work]);
    v8c_process(["git", "-C", $work, "checkout", "--detach", $commit]);
} catch (V8CatalogException $exception) { fwrite(STDERR, "PLUGIN_CLONE_FAILED\n"); exit(72); }
if (is_file($work . "/.gitmodules")) { fwrite(STDERR, "PLUGIN_SUBMODULES_UNSUPPORTED\n"); exit(73); }
$text = (string)@file_get_contents($work . "/version.php");
$value = static fn(string $field, string $pattern): ?string => preg_match('/\$plugin->' . $field . '\s*=\s*' . $pattern . '\s*;/', $text, $m) ? $m[count($m) - 1] : null;
if ($value("component", "([\'\"])([^\'\"]+)\\1") !== $component) { fwrite(STDERR, "PLUGIN_COMPONENT_MISMATCH\n"); exit(74); }
$version = $value("version", "([0-9]+)");
$requires = $value("requires", "([0-9]+)");
if ($version === null || $requires === null) { fwrite(STDERR, "PLUGIN_VERSION_MISSING\n"); exit(75); }
$release = $value("release", "([\'\"])([^\'\"]*)\\1");
$dependencies = [];
if (preg_match('/\$plugin->dependencies\s*=\s*(?:array\(|\[)(.*?)(?:\)|\])\s*;/s', $text, $block)) {
    preg_match_all('/([\'\"])([a-z][a-z0-9]*_[a-z][a-z0-9_]*)\1\s*=>\s*([0-9]+|ANY_VERSION)/', $block[1], $pairs, PREG_SET_ORDER);
    foreach ($pairs as $pair) { $dependencies[$pair[2]] = $pair[3] === "ANY_VERSION" ? 1 : (int)$pair[3]; }
}
$entry = ["status" => "known_good_candidate", "type" => $type, "repository" => $repository, "path" => "public/" . $dirs[$type] . "/" . $name,
    "commit" => $commit, "version" => (int)$version, "release" => $release, "tree_sha256" => v8c_tree_sha256($work),
    "requires" => (int)$requires, "supported" => ["5.2"], "incompatible" => null, "dependencies" => $dependencies, "submodules" => [],
    "validated_from_versions" => [], "provenance" => ["context" => "MoodleWebToolkit", "reviewed_by" => "pendiente"]];
@mkdir(getcwd() . "/exports/plugin-proposals", 0775, true);
v8c_atomic_json(getcwd() . "/exports/plugin-proposals/" . $component . ".json", ["component" => $component, "entry" => $entry]);
v8c_delete_tree($work);
echo "PLUGIN_INSPECTED component=$component version=$version tree=" . $entry["tree_sha256"] . PHP_EOL;
MWT_PHP
)
readonly PLUGIN_PROMOTE_PHP=$(cat <<'MWT_PHP'
// Promotes inspected proposals into the catalog with the Consolidator's own promotion rules.
require getcwd() . "/scripts/v8-plugin-catalog.php";
[, $components, $approver] = $argv;
$catalogPath = getcwd() . "/config/plugin-compatibility-catalog.json";
foreach (explode(",", $components) as $component) {
    $proposal = v8c_read_json(getcwd() . "/exports/plugin-proposals/" . $component . ".json");
    $catalog = v8c_read_json($catalogPath);
    if (isset($catalog["entries"][$component])) { echo "PLUGIN_ALREADY_IN_CATALOG component=$component" . PHP_EOL; continue; }
    $proposal["entry"]["provenance"]["reviewed_by"] = $approver;
    $catalog = v8c_promote($catalog, ["component" => $component, "entry" => $proposal["entry"], "approval" => [
        "approved_by" => $approver, "approved_at" => gmdate("Y-m-d"),
        "evidence" => "MoodleWebToolkit: inspección del commit " . $proposal["entry"]["commit"]]]);
    v8c_atomic_json($catalogPath, $catalog);
    echo "PLUGIN_PROMOTED component=$component" . PHP_EOL;
}
MWT_PHP
)
readonly UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

json_escape() {
    local value=$1 out='' char code i
    for ((i = 0; i < ${#value}; i++)); do
        char=${value:i:1}
        case $char in
            '"') out+='\"' ;;
            '\') out+='\\' ;;
            $'\n') out+='\n' ;;
            $'\r') out+='\r' ;;
            $'\t') out+='\t' ;;
            *)
                printf -v code '%d' "'$char"
                if ((code >= 0 && code < 32)); then
                    printf -v char '\\u%04x' "$code"
                fi
                out+=$char
                ;;
        esac
    done
    printf '"%s"' "$out"
}

json_or_null() {
    if [[ -n ${1:-} ]]; then json_escape "$1"; else printf 'null'; fi
}

int_or_null() {
    if [[ ${1:-} =~ ^[0-9]+$ ]]; then printf '%s' "$1"; else printf 'null'; fi
}

bool() {
    if [[ $1 == 1 ]]; then printf 'true'; else printf 'false'; fi
}

respond_ok() {
    printf '{"schema":"%s","ok":true,"agent_version":"%s","command":%s,"data":%s}\n' \
        "$SCHEMA" "$AGENT_VERSION" "$(json_escape "$1")" "$2"
    exit 0
}

# Error codes are closed identifiers; free text is never returned.
fail() {
    printf '{"schema":"%s","ok":false,"agent_version":"%s","command":%s,"error":{"code":"%s"}}\n' \
        "$SCHEMA" "$AGENT_VERSION" "$(json_escape "${COMMAND:-unknown}")" "$1"
    exit "${2:-2}"
}

self_sha256() {
    sha256sum "$SELF_PATH" | cut -d' ' -f1
}

now_utc() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

has_systemd() {
    [[ -d /run/systemd/system ]] && command -v systemd-run >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1
}

launcher_mode() {
    if [[ $(id -u) == 0 ]] && has_systemd; then
        printf 'systemd'
    elif [[ ${MWT_AGENT_ALLOW_NOHUP:-0} == 1 ]]; then
        printf 'nohup'
    else
        printf 'unavailable'
    fi
}

write_atomic() {
    local target=$1 content=$2 tmp
    tmp=$(mktemp "${target}.XXXXXX")
    printf '%s\n' "$content" >"$tmp"
    sync "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$target"
}

file_size() {
    if [[ -f $1 ]]; then stat -c %s "$1"; else printf '0'; fi
}

file_sha256() {
    if [[ -f $1 ]]; then sha256sum "$1" | cut -d' ' -f1; fi
}

# Sets OP_DIR; never called inside a subshell so that fail() reaches stdout.
require_operation() {
    [[ $1 =~ $UUID_RE ]] || fail invalid_operation_uuid
    OP_DIR="$OPS_DIR/$1"
}

# Canonical tree hash, identical to the platform's ToolDistributionVerifier:
# sha256 of "path\0sha256" rows sorted bytewise and joined by "\n".
tree_hash() {
    (
        cd "$1"
        first=1
        find . -type f -printf '%P\0' | LC_ALL=C sort -z | while IFS= read -r -d '' file; do
            if ((first)); then first=0; else printf '\n'; fi
            printf '%s\0%s' "$file" "$(sha256sum -- "$file" | cut -c1-64)"
        done
    ) | sha256sum | cut -c1-64
}

# Anything that is neither a regular file nor a directory: links, sockets, devices.
unsafe_entries() {
    find "$1" ! -type f ! -type d | wc -l
}

safe_path() {
    [[ $1 =~ $PATH_RE && $1 != *..* ]]
}

# Sets SRC_* from an administrator-owned profile; fails closed on anything else.
load_source() {
    local id=$1 file line key value
    [[ $id =~ $SOURCE_RE ]] || fail invalid_source
    file="$SOURCES_DIR/$id.conf"
    [[ -f $file && ! -L $file ]] || fail source_not_found
    if [[ $(id -u) == 0 ]]; then
        [[ $(stat -c %u "$file") == 0 ]] || fail source_profile_unsafe
    fi
    # Neither group nor others may write the profile.
    (((8#$(stat -c '%a' "$file") & 8#022) == 0)) || fail source_profile_unsafe
    SRC_ID=$id SRC_MOODLE_CONFIG='' SRC_RUNTIME='' SRC_RUN_AS='' SRC_COMPOSE_DIR='' SRC_COMPOSE_SERVICE='' SRC_COMPOSE_PROFILE=''
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        [[ $line =~ ^([A-Z_]{2,32})=(.*)$ ]] || fail source_profile_invalid
        key=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        case $key in
            MOODLE_CONFIG) safe_path "$value" || fail source_profile_invalid; SRC_MOODLE_CONFIG=$value ;;
            RUNTIME) [[ $value == native || $value == compose ]] || fail source_profile_invalid; SRC_RUNTIME=$value ;;
            RUN_AS) [[ $value =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail source_profile_invalid; SRC_RUN_AS=$value ;;
            COMPOSE_DIR) safe_path "$value" || fail source_profile_invalid; SRC_COMPOSE_DIR=$value ;;
            COMPOSE_SERVICE) [[ $value =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] || fail source_profile_invalid; SRC_COMPOSE_SERVICE=$value ;;
            COMPOSE_PROFILE) [[ $value =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] || fail source_profile_invalid; SRC_COMPOSE_PROFILE=$value ;;
            *) fail source_profile_invalid ;;
        esac
    done <"$file"
    [[ -n $SRC_MOODLE_CONFIG && -n $SRC_RUNTIME && -n $SRC_RUN_AS ]] || fail source_profile_invalid
    if [[ $SRC_RUNTIME == compose ]]; then
        [[ -n $SRC_COMPOSE_DIR && -n $SRC_COMPOSE_SERVICE && -f $SRC_COMPOSE_DIR/compose.yaml ]] || fail source_profile_invalid
    fi
}

# Sets SRC_EXEC: the prefix that runs a command inside the source's PHP runtime,
# with the given host directories mounted at the same path (":ro" suffix allowed).
source_exec() {
    local mount
    if [[ $SRC_RUNTIME == compose ]]; then
        SRC_EXEC=(docker compose --project-directory "$SRC_COMPOSE_DIR" -f "$SRC_COMPOSE_DIR/compose.yaml")
        [[ -n $SRC_COMPOSE_PROFILE ]] && SRC_EXEC+=(--profile "$SRC_COMPOSE_PROFILE")
        SRC_EXEC+=(run --rm --no-deps -T)
        for mount in "$@"; do
            SRC_EXEC+=(-v "${mount%:ro}:$mount")
        done
        SRC_EXEC+=("$SRC_COMPOSE_SERVICE")
    elif [[ $(id -u) == 0 ]]; then
        SRC_EXEC=(runuser -u "$SRC_RUN_AS" --)
    else
        SRC_EXEC=()
    fi
}

# Sets DST_* from an administrator-owned destination profile; fails closed on anything else.
load_destination() {
    local id=$1 file line key value
    [[ $id =~ $SOURCE_RE ]] || fail invalid_destination
    file="$DESTINATIONS_DIR/$id.conf"
    [[ -f $file && ! -L $file ]] || fail destination_not_found
    if [[ $(id -u) == 0 ]]; then
        [[ $(stat -c %u "$file") == 0 ]] || fail destination_profile_unsafe
    fi
    (((8#$(stat -c '%a' "$file") & 8#022) == 0)) || fail destination_profile_unsafe
    DST_ID=$id DST_RUNTIME_DIR='' DST_PUBLIC_URL='' DST_TOOL_TREE='' DST_RUN_AS=''
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z $line || $line == \#* ]] && continue
        [[ $line =~ ^([A-Z_]{2,32})=(.*)$ ]] || fail destination_profile_invalid
        key=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        case $key in
            RUNTIME_DIR) safe_path "$value" || fail destination_profile_invalid; DST_RUNTIME_DIR=$value ;;
            PUBLIC_URL) [[ $value =~ $HTTPS_URL_RE ]] || fail destination_profile_invalid; DST_PUBLIC_URL=$value ;;
            TOOL_TREE) [[ $value =~ $SHA_RE ]] || fail destination_profile_invalid; DST_TOOL_TREE=$value ;;
            RUN_AS) [[ $value =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail destination_profile_invalid; DST_RUN_AS=$value ;;
            *) fail destination_profile_invalid ;;
        esac
    done <"$file"
    [[ -n $DST_RUNTIME_DIR && -n $DST_PUBLIC_URL && -n $DST_TOOL_TREE && -n $DST_RUN_AS ]] || fail destination_profile_invalid
    # The Consolidator refuses root (its exports are chowned to the invoking user), so it
    # runs as the runtime's unprivileged owner; Docker access comes from its group.
    local uid
    uid=$(id -u "$DST_RUN_AS" 2>/dev/null) || fail destination_user_missing
    ((uid > 0)) || fail destination_user_invalid
    if [[ $(id -u) == 0 ]]; then
        DST_EXEC=(runuser -u "$DST_RUN_AS" --)
    else
        [[ $(id -un) == "$DST_RUN_AS" ]] || fail destination_user_mismatch
        DST_EXEC=()
    fi
}

# The runtime and everything the Consolidator runs from belongs to the profile's user.
destination_owned() {
    [[ $(stat -c %U "$DST_RUNTIME_DIR") == "$DST_RUN_AS" ]] || return 1
    [[ -z $(find "$DST_RUNTIME_DIR" -maxdepth 1 -user 0 -print -quit 2>/dev/null) ]]
}

# The Consolidator's engine in a runtime is unchanged against its own manifest.
# config.yaml and config/ hold the operator's configuration, policies and
# resolutions, which the Consolidator (its package import included) and its
# operator edit on purpose; docker/custom-plugins/ is where the Consolidator
# installs the catalog plugins it resolved, each checked against its pin when
# the target image is built. Everything else must match.
engine_intact() {
    [[ -f $1/FILES.sha256 && ! -L $1/FILES.sha256 ]] || return 1
    (cd "$1" && grep -v '^[0-9a-f]\{64\}  \./\(config/\|config\.yaml$\|docker/custom-plugins/\)' FILES.sha256 \
        | sha256sum --quiet --check - >/dev/null 2>&1)
}

# The Consolidator resolved its plugin lock from the sources' needs and it asks for
# nothing: no catalog plugin and no unknown component. The needs document, when the
# assistant has not archived it after a failed validation, must be empty as well.
plugins_none() {
    local needs=$1/exports/phase2/plugin_compatibility_needs.json
    [[ -f $1/exports/plugin-lock.json && ! -L $1/exports/plugin-lock.json && ! -L $needs ]] || return 1
    python3 -I - "$1/exports/plugin-lock.json" "$needs" <<'PY' >/dev/null 2>&1
import json, os, sys
lock = json.load(open(sys.argv[1], encoding="utf-8-sig"))
needs = json.load(open(sys.argv[2], encoding="utf-8-sig")) if os.path.isfile(sys.argv[2]) else {"original_compatibility_needs": []}
empty = lambda value: isinstance(value, list) and len(value) == 0
resolved = isinstance(lock.get("compatibility_needs_sha256"), str) and len(lock["compatibility_needs_sha256"]) == 64
sys.exit(0 if resolved and empty(lock.get("plugins")) and empty(lock.get("unknown_plugins")) and empty(needs.get("original_compatibility_needs")) else 1)
PY
}

# --- Registered operations -------------------------------------------------

# Sets REGISTERED_ARGV to the validated argv of a registered operation.
registered_argv() {
    local key=$1
    shift
    declare -A params=()
    local pair name value
    for pair in "$@"; do
        [[ $pair =~ ^([a-z_]{1,32})=([A-Za-z0-9._:-]{0,128})$ ]] || fail invalid_parameter
        name=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        [[ -z ${params[$name]+set} ]] || fail duplicate_parameter
        params[$name]=$value
    done
    # Recorded in launch.json: every value already matched the closed pattern above.
    local sep=''
    REGISTERED_PARAMS_JSON='{'
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        REGISTERED_PARAMS_JSON+="$sep\"$name\":\"${params[$name]}\""
        sep=','
    done < <(printf '%s\n' "${!params[@]}" | LC_ALL=C sort)
    REGISTERED_PARAMS_JSON+='}'

    case $key in
        diagnostic.sleep)
            [[ ${#params[@]} == 1 && ${params[seconds]:-} =~ ^[1-9][0-9]{0,4}$ ]] || fail invalid_parameter
            ((params[seconds] <= 86400)) || fail invalid_parameter
            REGISTERED_ARGV=(sleep "${params[seconds]}")
            ;;
        diagnostic.fail)
            [[ ${#params[@]} == 1 && ${params[code]:-} =~ ^[1-9][0-9]?$ ]] || fail invalid_parameter
            # shellcheck disable=SC2016
            REGISTERED_ARGV=(bash -c 'exit "$1"' diagnostic-fail "${params[code]}")
            ;;
        diagnostic.lines)
            [[ ${#params[@]} == 1 && ${params[count]:-} =~ ^[1-9][0-9]{0,3}$ ]] || fail invalid_parameter
            # shellcheck disable=SC2016
            REGISTERED_ARGV=(bash -c 'for ((i = 1; i <= $1; i++)); do printf "linea %d\n" "$i"; done; printf "fin\n" >&2' diagnostic-lines "${params[count]}")
            ;;
        collector.742)
            [[ ${#params[@]} == 4 && ${params[distribution]:-} =~ $SHA_RE && ${params[source]:-} =~ $SOURCE_RE
                && ${params[package]:-} =~ ^[a-z][a-z0-9_-]{0,63}$ && ${params[workers]:-} =~ ^(auto|[1-4])$ ]] || fail invalid_parameter
            local tool="$TOOLS_DIR/$COLLECTOR_TOOL_KEY/${params[distribution]}" work="$OP_DIR/work"
            [[ -f $tool/EXPORTAR-ORIGEN.sh ]] || fail tool_not_installed
            # Re-verified on every launch: a modified tree never runs.
            (($(unsafe_entries "$tool") == 0)) && [[ $(tree_hash "$tool") == "${params[distribution]}" ]] || fail tool_hash_mismatch
            load_source "${params[source]}"
            source_exec "$tool:ro" "$work"
            # The wrapper runs as root under systemd: it opens only traversal to the
            # operation directory and gives the work area to the source's runtime user.
            # shellcheck disable=SC2016
            REGISTERED_ARGV=(bash -c 'chmod 0711 "$1" && install -d -o "$2" -g "$2" -m 0700 "$3" "$3/output" "$3/tmp" && shift 3 && exec "$@"'
                collector-prepare "$OP_DIR" "$SRC_RUN_AS" "$work" "${SRC_EXEC[@]}"
                bash "$tool/EXPORTAR-ORIGEN.sh" "--workers=${params[workers]}" "--output-dir=$work/output" "--temp-dir=$work/tmp"
                "${params[package]}.zip" "$SRC_MOODLE_CONFIG")
            ;;
        consolidator.prepare)
            [[ ${#params[@]} == 3 && ${params[destination]:-} =~ $SOURCE_RE && ${params[distribution]:-} =~ $SHA_RE
                && ${params[reset]:-} =~ ^[01]$ ]] || fail invalid_parameter
            load_destination "${params[destination]}"
            [[ $DST_TOOL_TREE == "${params[distribution]}" ]] || fail tool_tree_mismatch
            local store
            store=$(compgen -G "$TOOLS_DIR/moodle-consolidador-*/${params[distribution]}" | head -n 1) || fail tool_not_installed
            # The stored tree is re-verified on every launch, like the Collector's.
            (($(unsafe_entries "$store") == 0)) && [[ $(tree_hash "$store") == "${params[distribution]}" ]] || fail tool_hash_mismatch
            [[ -d $DST_RUNTIME_DIR && ! -L $DST_RUNTIME_DIR && -f $DST_RUNTIME_DIR/.env && -f $DST_RUNTIME_DIR/FILES.sha256 ]] || fail destination_runtime_missing
            if [[ ${params[reset]} == 1 ]]; then
                # The Consolidator's Compose project name is fixed: one runtime per server, so a
                # reset never takes down another profile's services.
                (($(find "$DESTINATIONS_DIR" -maxdepth 1 -type f -name '*.conf' | wc -l) == 1)) || fail destination_shared_server
                [[ $(id -u) == 0 ]] || fail reset_requires_root
                REGISTERED_ARGV=(bash "$SELF_PATH" __destination-prepare "${params[destination]}" "${params[distribution]}" "$OP_DIR")
            else
                # Preparing again after the Consolidator wrote to the site would recreate its services mid-migration.
                [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
                engine_intact "$DST_RUNTIME_DIR" || fail engine_modified
                destination_owned || fail destination_owner_mismatch
                # shellcheck disable=SC2016
                REGISTERED_ARGV=("${DST_EXEC[@]}" bash -c 'cd "$1" && exec bash ./moodle-consolidation.sh preparar' consolidator-prepare "$DST_RUNTIME_DIR")
            fi
            ;;
        consolidator.run)
            [[ ${#params[@]} == 3 && ${params[destination]:-} =~ $SOURCE_RE && ${params[distribution]:-} =~ $SHA_RE
                && ${params[workers]:-} =~ ^(auto|[1-4])$ ]] || fail invalid_parameter
            load_destination "${params[destination]}"
            [[ $DST_TOOL_TREE == "${params[distribution]}" ]] || fail tool_tree_mismatch
            local consolidator
            consolidator=$(compgen -G "$TOOLS_DIR/moodle-consolidador-*/${params[distribution]}" | head -n 1) || fail tool_not_installed
            (($(unsafe_entries "$consolidator") == 0)) && [[ $(tree_hash "$consolidator") == "${params[distribution]}" ]] || fail tool_hash_mismatch
            [[ -d $DST_RUNTIME_DIR && ! -L $DST_RUNTIME_DIR && -f $DST_RUNTIME_DIR/.env ]] || fail destination_runtime_missing
            engine_intact "$DST_RUNTIME_DIR" || fail engine_modified
            destination_owned || fail destination_owner_mismatch
            # The assistant resumes from its own checkpoints; it is never run twice at once (flock inside).
            # The fuzzy identity candidates are reviewed in the platform: from rc13 on, the automatic
            # mode stops for them instead of skipping them. From 8.1.0 on it also stops for the
            # destination category map, decided in the platform before any category is written.
            # shellcheck disable=SC2016
            REGISTERED_ARGV=("${DST_EXEC[@]}" bash -c 'cd "$1" && export CONSOLIDATION_FUZZY_REVIEW=required CONSOLIDATION_CATEGORY_MAP=required && exec bash ./moodle-consolidation.sh ejecutar-automatico "--workers=$2"' consolidator-run
                "$DST_RUNTIME_DIR" "${params[workers]}")
            ;;
        consolidator.plugins-approve)
            [[ ${#params[@]} == 2 && ${params[destination]:-} =~ $SOURCE_RE && ${params[distribution]:-} =~ $SHA_RE ]] || fail invalid_parameter
            load_destination "${params[destination]}"
            [[ $DST_TOOL_TREE == "${params[distribution]}" ]] || fail tool_tree_mismatch
            local approver
            approver=$(compgen -G "$TOOLS_DIR/moodle-consolidador-*/${params[distribution]}" | head -n 1) || fail tool_not_installed
            (($(unsafe_entries "$approver") == 0)) && [[ $(tree_hash "$approver") == "${params[distribution]}" ]] || fail tool_hash_mismatch
            [[ -d $DST_RUNTIME_DIR && ! -L $DST_RUNTIME_DIR && -f $DST_RUNTIME_DIR/.env ]] || fail destination_runtime_missing
            engine_intact "$DST_RUNTIME_DIR" || fail engine_modified
            # Plugins are approved before the first write; afterwards the sealed lock is final.
            [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
            grep -q '"status": *"READY_FOR_APPROVAL"' "$DST_RUNTIME_DIR/exports/phase2/plugin_intervention_checkpoint.json" 2>/dev/null || fail plugins_not_ready_for_approval
            destination_owned || fail destination_owner_mismatch
            # The same two steps the assistant runs on [Y], inside its own runtime container and
            # under its run lock, so they never overlap a running assistant.
            # shellcheck disable=SC2016
            REGISTERED_ARGV=("${DST_EXEC[@]}" bash -c 'set -euo pipefail; cd "$1"
                socket=/var/run/docker.sock
                export ASSISTANT_PROJECT_ROOT="$1" ASSISTANT_UID="$(id -u)" ASSISTANT_GID="$(id -g)" DOCKER_SOCKET_PATH=$socket
                export DOCKER_GID="$(stat -c %g "$socket")" COMPOSE_PROJECT_NAME=moodle-consolidation-production
                set -a; . ./.env; set +a
                export MOODLE_MANAGED_CONFIG_DIR="${MOODLE_MANAGED_CONFIG_DIR:-$1/managed-config}"
                exec {lock}>reports/assistant-run.lock
                flock -n "$lock" || { echo "ASSISTANT_RUNNING" >&2; exit 61; }
                compose=(docker compose --project-name moodle-consolidation-production)
                "${compose[@]}" run --rm --no-deps -T assistant-runtime pwsh -NoLogo -NoProfile -File scripts/audit-package-plugins.ps1 -Mode Approve
                "${compose[@]}" run --rm --no-deps -T assistant-runtime pwsh -NoLogo -NoProfile -File scripts/v8-plugin-resolver.ps1 -Mode Seal
                echo PLUGIN_INTERVENTION_APPROVED' consolidator-plugins-approve "$DST_RUNTIME_DIR")
            ;;
        consolidator.plugins-none)
            [[ ${#params[@]} == 2 && ${params[destination]:-} =~ $SOURCE_RE && ${params[distribution]:-} =~ $SHA_RE ]] || fail invalid_parameter
            load_destination "${params[destination]}"
            [[ $DST_TOOL_TREE == "${params[distribution]}" ]] || fail tool_tree_mismatch
            local sealer
            sealer=$(compgen -G "$TOOLS_DIR/moodle-consolidador-*/${params[distribution]}" | head -n 1) || fail tool_not_installed
            (($(unsafe_entries "$sealer") == 0)) && [[ $(tree_hash "$sealer") == "${params[distribution]}" ]] || fail tool_hash_mismatch
            [[ -d $DST_RUNTIME_DIR && ! -L $DST_RUNTIME_DIR && -f $DST_RUNTIME_DIR/.env ]] || fail destination_runtime_missing
            engine_intact "$DST_RUNTIME_DIR" || fail engine_modified
            [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
            destination_owned || fail destination_owner_mismatch
            command -v python3 >/dev/null 2>&1 || fail python3_missing
            # Only when the Consolidator's own lock and needs ask for no plugin at all.
            plugins_none "$DST_RUNTIME_DIR" || fail plugins_required
            # Consolidator rc12 rewrites the pin manifest even with nothing to install and then
            # skips the image rebuild and the seal; this runs the steps it would have run with
            # plugins, inside its runtime and under its run lock.
            # shellcheck disable=SC2016
            REGISTERED_ARGV=("${DST_EXEC[@]}" bash -c 'set -euo pipefail; cd "$1"
                socket=/var/run/docker.sock
                export ASSISTANT_PROJECT_ROOT="$1" ASSISTANT_UID="$(id -u)" ASSISTANT_GID="$(id -g)" DOCKER_SOCKET_PATH=$socket
                export DOCKER_GID="$(stat -c %g "$socket")" COMPOSE_PROJECT_NAME=moodle-consolidation-production
                set -a; . ./.env; set +a
                export MOODLE_MANAGED_CONFIG_DIR="${MOODLE_MANAGED_CONFIG_DIR:-$1/managed-config}"
                exec {lock}>reports/assistant-run.lock
                flock -n "$lock" || { echo "ASSISTANT_RUNNING" >&2; exit 61; }
                compose=(docker compose --project-name moodle-consolidation-production)
                pins=$(sha256sum docker/custom-plugins/approved-plugins.json | cut -c1-64)
                image=$("${compose[@]}" exec -T moodle-target sha256sum /opt/approved-plugins.json 2>/dev/null | cut -c1-64) || image=""
                if [[ $pins != "$image" ]]; then
                    echo "PLUGIN_PINS_REBUILD"
                    "${compose[@]}" build moodle-target
                    "${compose[@]}" up -d --force-recreate moodle-target
                    container=$("${compose[@]}" ps -q moodle-target)
                    for _ in $(seq 1 72); do
                        [[ $(docker inspect -f "{{.State.Health.Status}}" "$container") == healthy ]] && break
                        sleep 5
                    done
                    [[ $(docker inspect -f "{{.State.Health.Status}}" "$container") == healthy ]] || { echo "TARGET_NOT_HEALTHY" >&2; exit 62; }
                fi
                "${compose[@]}" run --rm --no-deps -T assistant-runtime pwsh -NoLogo -NoProfile -File scripts/audit-package-plugins.ps1 -Mode Revalidate
                "${compose[@]}" run --rm --no-deps -T assistant-runtime pwsh -NoLogo -NoProfile -File scripts/v8-plugin-resolver.ps1 -Mode Seal
                python3 -I -c "import json,sys; d=json.load(open(sys.argv[1], encoding=\"utf-8-sig\")); sys.exit(0 if d.get(\"lock_status\") == \"SEALED\" and d.get(\"plugin_lock_valid\") is True else 1)" exports/plugin-lock.json \
                    || { echo "PLUGIN_LOCK_NOT_SEALED" >&2; exit 63; }
                echo PLUGINS_NONE_SEALED' consolidator-plugins-none "$DST_RUNTIME_DIR")
            ;;
        consolidator.identity-apply)
            [[ ${#params[@]} == 2 && ${params[destination]:-} =~ $SOURCE_RE && ${params[distribution]:-} =~ $SHA_RE ]] || fail invalid_parameter
            load_destination "${params[destination]}"
            [[ $DST_TOOL_TREE == "${params[distribution]}" ]] || fail tool_tree_mismatch
            local reviewer
            reviewer=$(compgen -G "$TOOLS_DIR/moodle-consolidador-*/${params[distribution]}" | head -n 1) || fail tool_not_installed
            (($(unsafe_entries "$reviewer") == 0)) && [[ $(tree_hash "$reviewer") == "${params[distribution]}" ]] || fail tool_hash_mismatch
            [[ -d $DST_RUNTIME_DIR && ! -L $DST_RUNTIME_DIR && -f $DST_RUNTIME_DIR/.env ]] || fail destination_runtime_missing
            engine_intact "$DST_RUNTIME_DIR" || fail engine_modified
            [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
            [[ -f $DST_RUNTIME_DIR/exports/identity_candidate_review.csv ]] || fail identity_review_missing
            destination_owned || fail destination_owner_mismatch
            # The same step as [I] of the interactive mode, in the assistant's container and under its lock.
            # shellcheck disable=SC2016
            REGISTERED_ARGV=("${DST_EXEC[@]}" bash -c 'set -euo pipefail; cd "$1"
                socket=/var/run/docker.sock
                export ASSISTANT_PROJECT_ROOT="$1" ASSISTANT_UID="$(id -u)" ASSISTANT_GID="$(id -g)" DOCKER_SOCKET_PATH=$socket
                export DOCKER_GID="$(stat -c %g "$socket")" COMPOSE_PROJECT_NAME=moodle-consolidation-production
                set -a; . ./.env; set +a
                export MOODLE_MANAGED_CONFIG_DIR="${MOODLE_MANAGED_CONFIG_DIR:-$1/managed-config}"
                exec {lock}>reports/assistant-run.lock
                flock -n "$lock" || { echo "ASSISTANT_RUNNING" >&2; exit 61; }
                docker compose --project-name moodle-consolidation-production run --rm --no-deps -T assistant-runtime \
                    pwsh -NoLogo -NoProfile -File scripts/v8-identity-review.ps1 -Mode Apply
                echo IDENTITY_REVIEW_APPLIED' consolidator-identity-apply "$DST_RUNTIME_DIR")
            ;;
        consolidator.plugin-inspect)
            [[ ${#params[@]} == 5 && ${params[destination]:-} =~ $SOURCE_RE && ${params[distribution]:-} =~ $SHA_RE
                && ${params[component]:-} =~ ^[a-z][a-z0-9]*_[a-z][a-z0-9_]{0,60}$ && ${params[commit]:-} =~ ^[0-9a-f]{40}$
                && ${params[repository]:-} =~ ^[A-Za-z0-9_-]{8,160}$ ]] || fail invalid_parameter
            load_destination "${params[destination]}"
            [[ $DST_TOOL_TREE == "${params[distribution]}" ]] || fail tool_tree_mismatch
            local repository
            repository=$(decode_chunks "${params[repository]}") || fail invalid_parameter
            # The catalog's own rule: public Git repositories on GitHub or Bitbucket.
            [[ $repository =~ ^https://(github\.com|bitbucket\.org)/[A-Za-z0-9._/-]{3,120}\.git$ && $repository != *..* ]] || fail invalid_parameter
            [[ -d $DST_RUNTIME_DIR && ! -L $DST_RUNTIME_DIR && -f $DST_RUNTIME_DIR/.env ]] || fail destination_runtime_missing
            [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
            engine_intact "$DST_RUNTIME_DIR" || fail engine_modified
            destination_owned || fail destination_owner_mismatch
            # shellcheck disable=SC2016
            REGISTERED_ARGV=("${DST_EXEC[@]}" bash -c 'set -euo pipefail; cd "$1"
                socket=/var/run/docker.sock
                export ASSISTANT_PROJECT_ROOT="$1" ASSISTANT_UID="$(id -u)" ASSISTANT_GID="$(id -g)" DOCKER_SOCKET_PATH=$socket
                export DOCKER_GID="$(stat -c %g "$socket")" COMPOSE_PROJECT_NAME=moodle-consolidation-production
                set -a; . ./.env; set +a
                export MOODLE_MANAGED_CONFIG_DIR="${MOODLE_MANAGED_CONFIG_DIR:-$1/managed-config}"
                exec {lock}>reports/assistant-run.lock
                flock -n "$lock" || { echo "ASSISTANT_RUNNING" >&2; exit 61; }
                docker compose --project-name moodle-consolidation-production run --rm --no-deps -T assistant-runtime php -r "$2" -- "$3" "$4" "$5"' \
                consolidator-plugin-inspect "$DST_RUNTIME_DIR" "$PLUGIN_INSPECT_PHP" "${params[component]}" "$repository" "${params[commit]}")
            ;;
        consolidator.plugin-promote)
            [[ ${#params[@]} == 4 && ${params[destination]:-} =~ $SOURCE_RE && ${params[distribution]:-} =~ $SHA_RE
                && ${params[components]:-} =~ ^[a-z][a-z0-9]*_[a-z][a-z0-9_]{0,60}(,[a-z][a-z0-9]*_[a-z][a-z0-9_]{0,60}){0,9}$
                && ${params[approver]:-} =~ ^[A-Za-z0-9_-]{4,160}$ ]] || fail invalid_parameter
            load_destination "${params[destination]}"
            [[ $DST_TOOL_TREE == "${params[distribution]}" ]] || fail tool_tree_mismatch
            local approver component
            approver=$(decode_chunks "${params[approver]}") || fail invalid_parameter
            [[ $approver =~ ^[[:print:]]{3,120}$ && $approver != *\'* ]] || fail invalid_parameter
            [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
            engine_intact "$DST_RUNTIME_DIR" || fail engine_modified
            destination_owned || fail destination_owner_mismatch
            for component in ${params[components]//,/ }; do
                [[ -f $DST_RUNTIME_DIR/exports/plugin-proposals/$component.json ]] || fail plugin_proposal_missing
            done
            # shellcheck disable=SC2016
            REGISTERED_ARGV=("${DST_EXEC[@]}" bash -c 'set -euo pipefail; cd "$1"
                socket=/var/run/docker.sock
                export ASSISTANT_PROJECT_ROOT="$1" ASSISTANT_UID="$(id -u)" ASSISTANT_GID="$(id -g)" DOCKER_SOCKET_PATH=$socket
                export DOCKER_GID="$(stat -c %g "$socket")" COMPOSE_PROJECT_NAME=moodle-consolidation-production
                set -a; . ./.env; set +a
                export MOODLE_MANAGED_CONFIG_DIR="${MOODLE_MANAGED_CONFIG_DIR:-$1/managed-config}"
                exec {lock}>reports/assistant-run.lock
                flock -n "$lock" || { echo "ASSISTANT_RUNNING" >&2; exit 61; }
                docker compose --project-name moodle-consolidation-production run --rm --no-deps -T assistant-runtime php -r "$2" -- "$3" "$4"' \
                consolidator-plugin-promote "$DST_RUNTIME_DIR" "$PLUGIN_PROMOTE_PHP" "${params[components]}" "$approver")
            ;;
        consolidator.site-upload)
            [[ ${#params[@]} == 6 && ${params[destination]:-} =~ $SOURCE_RE && ${params[project]:-} =~ $UUID_RE
                && ${params[execution]:-} =~ $UUID_RE && ${params[sha]:-} =~ $SHA_RE
                && ${params[bucket]:-} =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ && ${params[region]:-} =~ ^[a-z]{2}(-gov)?-[a-z]+-[1-9]$ ]] || fail invalid_parameter
            command -v aws >/dev/null 2>&1 || fail aws_cli_unavailable
            load_destination "${params[destination]}"
            [[ -f $DST_RUNTIME_DIR/exports/phase8/paquete-sitio-consolidado.zip && ! -L $DST_RUNTIME_DIR/exports/phase8/paquete-sitio-consolidado.zip ]] || fail site_package_missing
            REGISTERED_ARGV=(bash "$SELF_PATH" __site-upload "${params[destination]}" "${params[project]}" "${params[execution]}" "${params[sha]}"
                "${params[bucket]}" "${params[region]}" "$OP_DIR")
            ;;
        package.fetch)
            [[ ${#params[@]} == 6 && ${params[destination]:-} =~ $SOURCE_RE && ${params[project]:-} =~ $UUID_RE
                && ${params[source]:-} =~ ^[a-z0-9][a-z0-9_-]{0,63}$ && ${params[sha]:-} =~ $SHA_RE
                && ${params[bucket]:-} =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ && ${params[region]:-} =~ ^[a-z]{2}(-gov)?-[a-z]+-[1-9]$ ]] || fail invalid_parameter
            command -v aws >/dev/null 2>&1 || fail aws_cli_unavailable
            load_destination "${params[destination]}"
            [[ -d $DST_RUNTIME_DIR && ! -L $DST_RUNTIME_DIR ]] || fail destination_runtime_missing
            # Packages are fixed once the Consolidator wrote to the site.
            [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
            [[ ! -L $DST_RUNTIME_DIR/copias ]] || fail destination_profile_unsafe
            REGISTERED_ARGV=(bash "$SELF_PATH" __package-fetch "${params[destination]}" "${params[project]}" "${params[source]}" "${params[sha]}" "${params[bucket]}" "${params[region]}" "$OP_DIR")
            ;;
        package.upload)
            [[ ${#params[@]} == 4 && ${params[collector]:-} =~ $UUID_RE && ${params[project]:-} =~ $UUID_RE
                && ${params[bucket]:-} =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ && ${params[region]:-} =~ ^[a-z]{2}(-gov)?-[a-z]+-[1-9]$ ]] || fail invalid_parameter
            command -v aws >/dev/null 2>&1 || fail aws_cli_unavailable
            # Fails closed here, before any process exists, if the export is not a sealed success.
            # collector_package points OP_DIR at the export; keep this operation's own directory.
            local upload_dir=$OP_DIR
            collector_package "${params[collector]}"
            OP_DIR=$upload_dir
            REGISTERED_ARGV=(bash "$SELF_PATH" __package-upload "${params[collector]}" "${params[project]}" "${params[bucket]}" "${params[region]}" "$upload_dir")
            ;;
        *)
            fail unregistered_command
            ;;
    esac
}

# --- Subcommands ----------------------------------------------------------

cmd_version() {
    respond_ok version "{\"agent_sha256\":\"$(self_sha256)\",\"launcher\":\"$(launcher_mode)\"}"
}

cmd_probe() {
    local os_id='' os_version='' os_name='' kernel arch cpus mem_kb='' systemd_version=''
    local disk_total='' disk_free='' probe_dir php_version='' docker_version='' compose_version='' pwsh_version='' aws_version=''
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        os_id=$(. /etc/os-release && printf '%s' "${ID:-}")
        os_version=$(. /etc/os-release && printf '%s' "${VERSION_ID:-}")
        os_name=$(. /etc/os-release && printf '%s' "${PRETTY_NAME:-}")
    fi
    kernel=$(uname -r)
    arch=$(uname -m)
    cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '')
    if [[ -r /proc/meminfo ]]; then
        mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemd_version=$(systemctl --version 2>/dev/null | awk 'NR==1 {print $2}')
    fi
    probe_dir=$STATE_DIR
    [[ -d $probe_dir ]] || probe_dir=$(dirname "$STATE_DIR")
    if read -r disk_total disk_free < <(df -PB1 "$probe_dir" 2>/dev/null | awk 'NR==2 {print $2, $4}'); then :; fi
    command -v php >/dev/null 2>&1 && php_version=$(php -r 'echo PHP_VERSION;' 2>/dev/null || true)
    command -v docker >/dev/null 2>&1 && docker_version=$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',' || true)
    command -v docker >/dev/null 2>&1 && compose_version=$(docker compose version --short 2>/dev/null || true)
    command -v pwsh >/dev/null 2>&1 && pwsh_version=$(pwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()' 2>/dev/null || true)
    command -v aws >/dev/null 2>&1 && aws_version=$(aws --version 2>&1 | awk '{print $1}' | cut -d/ -f2 || true)

    local data
    data=$(printf '{"agent_sha256":"%s","hostname":%s,"os_id":%s,"os_version":%s,"os_name":%s,"kernel":%s,"arch":%s,"cpus":%s,"memory_bytes":%s,"is_root":%s,"systemd":%s,"systemd_version":%s,"launcher":"%s","bash_version":%s,"state_dir_exists":%s,"disk_total_bytes":%s,"disk_free_bytes":%s,"php_version":%s,"docker_version":%s,"compose_version":%s,"pwsh_version":%s,"aws_cli_version":%s,"observed_at":"%s"}' \
        "$(self_sha256)" "$(json_escape "$(hostname)")" "$(json_or_null "$os_id")" "$(json_or_null "$os_version")" \
        "$(json_or_null "$os_name")" "$(json_escape "$kernel")" "$(json_escape "$arch")" "$(int_or_null "$cpus")" \
        "$(if [[ $mem_kb =~ ^[0-9]+$ ]]; then printf '%s' $((mem_kb * 1024)); else printf 'null'; fi)" \
        "$(bool "$([[ $(id -u) == 0 ]] && echo 1 || echo 0)")" "$(bool "$(has_systemd && echo 1 || echo 0)")" \
        "$(json_or_null "$systemd_version")" "$(launcher_mode)" "$(json_escape "$BASH_VERSION")" \
        "$(bool "$([[ -d $STATE_DIR ]] && echo 1 || echo 0)")" "$(int_or_null "$disk_total")" "$(int_or_null "$disk_free")" \
        "$(json_or_null "$php_version")" "$(json_or_null "$docker_version")" "$(json_or_null "$compose_version")" "$(json_or_null "$pwsh_version")" \
        "$(json_or_null "$aws_version")" "$(now_utc)")
    respond_ok probe "$data"
}

cmd_launch() {
    (($# >= 2)) || fail invalid_arguments
    local uuid=$1 key=$2 dir mode unit argv_file
    shift 2
    require_operation "$uuid"
    dir=$OP_DIR
    REGISTERED_ARGV=()
    registered_argv "$key" "$@"
    ((${#REGISTERED_ARGV[@]} > 0)) || fail unregistered_command

    mode=$(launcher_mode)
    [[ $mode != unavailable ]] || fail launcher_unavailable
    mkdir -p "$OPS_DIR"
    # Traversal only (no listing): a source runtime user must reach its own work area.
    chmod 711 "$STATE_DIR" "$OPS_DIR"

    # Idempotent: a repeated launch of the same operation reports the first one.
    if ! mkdir "$dir" 2>/dev/null; then
        [[ -f $dir/launch.json ]] || fail launch_in_progress
        local existing_key
        existing_key=$(sed -n 's/.*"command_key":"\([^"]*\)".*/\1/p' "$dir/launch.json")
        [[ $existing_key == "$key" ]] || fail operation_conflict
        respond_ok launch "{\"operation_uuid\":\"$uuid\",\"created\":false,\"launch\":$(cat "$dir/launch.json")}"
    fi

    argv_file=$dir/argv
    printf '%s\0' "${REGISTERED_ARGV[@]}" >"$argv_file"
    unit="mwt-op-${uuid}"
    local launch
    launch=$(printf '{"operation_uuid":"%s","command_key":%s,"launcher":"%s","unit":%s,"agent_version":"%s","agent_sha256":"%s","argv_sha256":"%s","launched_at":"%s","parameters":%s}' \
        "$uuid" "$(json_escape "$key")" "$mode" "$(if [[ $mode == systemd ]]; then json_escape "$unit"; else printf 'null'; fi)" \
        "$AGENT_VERSION" "$(self_sha256)" "$(file_sha256 "$argv_file")" "$(now_utc)" "$REGISTERED_PARAMS_JSON")
    write_atomic "$dir/launch.json" "$launch"

    if [[ $mode == systemd ]]; then
        systemd-run --quiet --unit="$unit" --collect --property=KillMode=control-group \
            --property=TimeoutStopSec=30 --setenv=MWT_AGENT_STATE_DIR="$STATE_DIR" \
            /usr/bin/env bash "$SELF_PATH" __run "$uuid" >/dev/null 2>&1 || fail launch_failed
    else
        MWT_AGENT_STATE_DIR=$STATE_DIR setsid nohup bash "$SELF_PATH" __run "$uuid" \
            </dev/null >/dev/null 2>&1 &
    fi
    respond_ok launch "{\"operation_uuid\":\"$uuid\",\"created\":true,\"launch\":$launch}"
}

# Internal entrypoint executed by systemd or setsid; never called by the platform.
cmd_run() {
    local uuid=$1 dir child heartbeat_pid exit_code
    require_operation "$uuid"
    dir=$OP_DIR
    [[ -f $dir/launch.json && -f $dir/argv && ! -e $dir/exit.json ]] || exit 3
    mapfile -d '' -t argv <"$dir/argv"
    write_atomic "$dir/run.json" "{\"pid\":$$,\"started_at\":\"$(now_utc)\"}"

    (
        while :; do
            date -u +%Y-%m-%dT%H:%M:%SZ >"$dir/heartbeat.tmp" && mv -f "$dir/heartbeat.tmp" "$dir/heartbeat"
            sleep "$HEARTBEAT_SECONDS"
        done
    ) &
    heartbeat_pid=$!

    "${argv[@]}" >"$dir/stdout.log" 2>"$dir/stderr.log" &
    child=$!
    trap 'kill -TERM "$child" 2>/dev/null || true' TERM INT
    set +e
    wait "$child"
    exit_code=$?
    # A trapped signal interrupts wait; wait again for the real exit status.
    while kill -0 "$child" 2>/dev/null; do
        wait "$child"
        exit_code=$?
    done
    set -e
    kill "$heartbeat_pid" 2>/dev/null || true
    wait "$heartbeat_pid" 2>/dev/null || true

    write_atomic "$dir/exit.json" "$(printf '{"exit_code":%d,"cancel_requested":%s,"stdout_bytes":%s,"stdout_sha256":"%s","stderr_bytes":%s,"stderr_sha256":"%s","finished_at":"%s"}' \
        "$exit_code" "$(bool "$([[ -f $dir/cancel.json ]] && echo 1 || echo 0)")" \
        "$(file_size "$dir/stdout.log")" "$(file_sha256 "$dir/stdout.log")" \
        "$(file_size "$dir/stderr.log")" "$(file_sha256 "$dir/stderr.log")" "$(now_utc)")"
    exit "$exit_code"
}

unit_state() {
    local unit=$1
    systemctl show "$unit" --property=LoadState,ActiveState,SubState,MainPID --value 2>/dev/null | paste -sd' ' -
}

cmd_status() {
    (($# == 1)) || fail invalid_arguments
    local uuid=$1 dir launcher unit active='' sub='' main_pid='' load='' process_alive=0 heartbeat='' run_pid=''
    require_operation "$uuid"
    dir=$OP_DIR
    [[ -f $dir/launch.json ]] || fail operation_not_found 4
    launcher=$(sed -n 's/.*"launcher":"\([a-z]*\)".*/\1/p' "$dir/launch.json")
    if [[ -f $dir/run.json ]]; then
        run_pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$dir/run.json")
    fi
    if [[ $launcher == systemd ]]; then
        unit="mwt-op-${uuid}"
        read -r load active sub main_pid < <(unit_state "$unit" || printf '\n') || true
        [[ $active == active || $active == activating || $active == deactivating ]] && process_alive=1
    elif [[ -n $run_pid ]] && kill -0 "$run_pid" 2>/dev/null; then
        process_alive=1
    fi
    [[ -f $dir/heartbeat ]] && heartbeat=$(cat "$dir/heartbeat")

    local data
    data=$(printf '{"operation_uuid":"%s","launch":%s,"run":%s,"exit":%s,"cancel_requested":%s,"process_alive":%s,"unit":{"load_state":%s,"active_state":%s,"sub_state":%s,"main_pid":%s},"heartbeat_at":%s,"stdout_bytes":%s,"stderr_bytes":%s,"observed_at":"%s"}' \
        "$uuid" "$(cat "$dir/launch.json")" "$(if [[ -f $dir/run.json ]]; then cat "$dir/run.json"; else printf 'null'; fi)" \
        "$(if [[ -f $dir/exit.json ]]; then cat "$dir/exit.json"; else printf 'null'; fi)" \
        "$(bool "$([[ -f $dir/cancel.json ]] && echo 1 || echo 0)")" "$(bool "$process_alive")" \
        "$(json_or_null "$load")" "$(json_or_null "$active")" "$(json_or_null "$sub")" "$(int_or_null "$main_pid")" \
        "$(json_or_null "$heartbeat")" "$(file_size "$dir/stdout.log")" "$(file_size "$dir/stderr.log")" "$(now_utc)")
    respond_ok status "$data"
}

cmd_tail() {
    (($# == 4)) || fail invalid_arguments
    local uuid=$1 stream=$2 offset=$3 max=$4 dir file size chunk
    require_operation "$uuid"
    dir=$OP_DIR
    [[ $stream == stdout || $stream == stderr ]] || fail invalid_stream
    [[ $offset =~ ^[0-9]{1,15}$ && $max =~ ^[1-9][0-9]{0,4}$ ]] || fail invalid_arguments
    ((max <= MAX_TAIL_BYTES)) || fail invalid_arguments
    [[ -f $dir/launch.json ]] || fail operation_not_found 4
    file=$dir/$stream.log
    size=$(file_size "$file")
    ((offset <= size)) || fail offset_beyond_end
    chunk=''
    if ((size > offset)); then
        # head closes the pipe once it has max bytes; the SIGPIPE tail then receives is expected,
        # so pipefail is off inside this substitution only.
        chunk=$(set +o pipefail; tail -c +$((offset + 1)) "$file" | head -c "$max" | base64 -w0)
    fi
    local read_bytes
    read_bytes=$(printf '%s' "$chunk" | base64 -d | wc -c)
    respond_ok tail "{\"operation_uuid\":\"$uuid\",\"stream\":\"$stream\",\"offset\":$offset,\"next_offset\":$((offset + read_bytes)),\"size\":$size,\"data_base64\":\"$chunk\"}"
}

cmd_cancel() {
    (($# == 1)) || fail invalid_arguments
    local uuid=$1 dir launcher run_pid=''
    require_operation "$uuid"
    dir=$OP_DIR
    [[ -f $dir/launch.json ]] || fail operation_not_found 4
    if [[ -f $dir/exit.json ]]; then
        respond_ok cancel "{\"operation_uuid\":\"$uuid\",\"signalled\":false,\"already_finished\":true}"
    fi
    [[ -f $dir/cancel.json ]] || write_atomic "$dir/cancel.json" "{\"requested_at\":\"$(now_utc)\"}"
    launcher=$(sed -n 's/.*"launcher":"\([a-z]*\)".*/\1/p' "$dir/launch.json")
    if [[ $launcher == systemd ]]; then
        systemctl kill --signal=TERM "mwt-op-${uuid}" >/dev/null 2>&1 || true
    else
        [[ -f $dir/run.json ]] && run_pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$dir/run.json")
        [[ -n $run_pid ]] && kill -TERM "$run_pid" 2>/dev/null || true
    fi
    respond_ok cancel "{\"operation_uuid\":\"$uuid\",\"signalled\":true,\"already_finished\":false}"
}

cmd_tool_status() {
    (($# == 2)) || fail invalid_arguments
    local key=$1 sha=$2 dir present=0 actual='' files=0 unsafe=0
    [[ $key =~ $TOOL_KEY_RE && $sha =~ $SHA_RE ]] || fail invalid_arguments
    dir="$TOOLS_DIR/$key/$sha"
    if [[ -d $dir && ! -L $dir ]]; then
        present=1
        unsafe=$(unsafe_entries "$dir")
        files=$(find "$dir" -type f | wc -l)
        actual=$(tree_hash "$dir")
    fi
    respond_ok tool-status "$(printf '{"key":"%s","expected_sha256":"%s","present":%s,"tree_sha256":%s,"matches":%s,"file_count":%s,"unsafe_entries":%s}'         "$key" "$sha" "$(bool "$present")" "$(json_or_null "$actual")" "$(bool "$([[ $actual == "$sha" ]] && echo 1 || echo 0)")" "$files" "$unsafe")"
}

# Installs a tool tree staged by the platform: verifies the bundle hash, rejects
# unsafe archive members and moves it into place only if the canonical tree hash
# equals the catalog value.
cmd_tool_commit() {
    (($# == 4)) || fail invalid_arguments
    local key=$1 sha=$2 staging_id=$3 bundle_sha=$4 staging target tmp
    [[ $key =~ $TOOL_KEY_RE && $sha =~ $SHA_RE && $staging_id =~ $UUID_RE && $bundle_sha =~ $SHA_RE ]] || fail invalid_arguments
    staging="$STAGING_DIR/$staging_id"
    target="$TOOLS_DIR/$key/$sha"
    [[ -d $staging && ! -L $staging ]] || fail staging_not_found
    if [[ -d $target && $(unsafe_entries "$target") == 0 && $(tree_hash "$target") == "$sha" ]]; then
        rm -rf -- "$staging"
        respond_ok tool-commit "{\"key\":\"$key\",\"tree_sha256\":\"$sha\",\"installed\":false,\"already_present\":true}"
    fi
    find "$staging" -maxdepth 1 -name 'part-*' -type f -print0 | LC_ALL=C sort -z | xargs -0 cat | base64 -d >"$staging/bundle.tgz" 2>/dev/null || fail bundle_invalid
    [[ $(sha256sum "$staging/bundle.tgz" | cut -c1-64) == "$bundle_sha" ]] || fail bundle_hash_mismatch
    tar -tzf "$staging/bundle.tgz" >"$staging/members" 2>/dev/null || fail bundle_invalid
    if grep -qE '(^/|(^|/)\.\.(/|$))' "$staging/members"; then fail unsafe_entries; fi
    tmp="$TOOLS_DIR/$key/.incoming-$staging_id"
    rm -rf -- "$tmp"
    mkdir -p "$tmp"
    tar -xzf "$staging/bundle.tgz" --no-same-owner -C "$tmp" 2>/dev/null || { rm -rf -- "$tmp"; fail bundle_invalid; }
    (($(unsafe_entries "$tmp") == 0)) || { rm -rf -- "$tmp"; fail unsafe_entries; }
    [[ $(tree_hash "$tmp") == "$sha" ]] || { rm -rf -- "$tmp"; fail tree_hash_mismatch; }
    chmod -R u=rwX,go=rX "$tmp"
    chmod 0755 "$TOOLS_DIR" "$TOOLS_DIR/$key"
    rm -rf -- "$target"
    mv "$tmp" "$target"
    rm -rf -- "$staging"
    respond_ok tool-commit "$(printf '{"key":"%s","tree_sha256":"%s","installed":true,"already_present":false,"file_count":%s}'         "$key" "$sha" "$(find "$target" -type f | wc -l)")"
}

# Checks that a source profile can run the Collector: config.php readable by the
# runtime user and PHP with the extensions it needs. Prints no paths or content.
cmd_source_check() {
    (($# == 1)) || fail invalid_arguments
    local report php_version='' zip=0 dom=0 readable=0 moodle='' release='' version='' data_free='' data_writable=0 state_free='' probe_dir cpus aws_version=''
    load_source "$1"
    source_exec
    # shellcheck disable=SC2016
    report=$("${SRC_EXEC[@]}" php -r 'echo PHP_VERSION, " ", (int) class_exists("ZipArchive"), " ", (int) class_exists("DOMDocument"), " ", (int) is_readable($argv[1]);' "$SRC_MOODLE_CONFIG" 2>/dev/null) || fail source_runtime_unavailable
    if [[ $report =~ ^([0-9]+\.[0-9]+\.[0-9]+[A-Za-z0-9.-]*)\ ([01])\ ([01])\ ([01])$ ]]; then
        php_version=${BASH_REMATCH[1]} zip=${BASH_REMATCH[2]} dom=${BASH_REMATCH[3]} readable=${BASH_REMATCH[4]}
    else
        fail source_runtime_unavailable
    fi
    # Moodle loads only its configuration (no database connection) to report its
    # release and the space left in moodledata; paths and settings never leave.
    # shellcheck disable=SC2016
    moodle=$("${SRC_EXEC[@]}" php -r 'define("CLI_SCRIPT", true); define("ABORT_AFTER_CONFIG", true); ob_start();
        require $argv[1]; ob_end_clean(); $release = null; $version = null;
        if (is_readable($CFG->dirroot."/version.php")) { (function ($file) use (&$release, &$version) { include $file; })($CFG->dirroot."/version.php"); }
        $free = @disk_free_space($CFG->dataroot);
        echo "MWT|", is_string($release) ? $release : "", "|", is_numeric($version) ? (int) $version : "", "|",
            is_float($free) ? (int) $free : "", "|", (int) is_writable($CFG->dataroot);' "$SRC_MOODLE_CONFIG" 2>/dev/null | tail -n 1) || moodle=''
    if [[ $moodle =~ ^MWT\|([0-9A-Za-z\ .+()_:-]{0,64})\|([0-9]{0,12})\|([0-9]{0,20})\|([01])$ ]]; then
        release=${BASH_REMATCH[1]} version=${BASH_REMATCH[2]} data_free=${BASH_REMATCH[3]} data_writable=${BASH_REMATCH[4]}
    fi
    probe_dir=$STATE_DIR
    [[ -d $probe_dir ]] || probe_dir=$(dirname "$STATE_DIR")
    state_free=$(df -PB1 "$probe_dir" 2>/dev/null | awk 'NR==2 {print $4}') || state_free=''
    # The Collector's workers, and the package upload with the instance role through AWS CLI v2.
    cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '')
    command -v aws >/dev/null 2>&1 && aws_version=$(aws --version 2>&1 | awk '{print $1}' | cut -d/ -f2 || true)
    [[ $aws_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || aws_version=''
    respond_ok source-check "$(printf '{"source":"%s","runtime":"%s","run_as":"%s","php_version":"%s","zip":%s,"dom":%s,"config_readable":%s,"moodle_release":%s,"moodle_version":%s,"dataroot_free_bytes":%s,"dataroot_writable":%s,"state_free_bytes":%s,"cpus":%s,"aws_cli_version":%s,"aws_cli_v2":%s}' \
        "$SRC_ID" "$SRC_RUNTIME" "$SRC_RUN_AS" "$php_version" "$(bool "$zip")" "$(bool "$dom")" "$(bool "$readable")" \
        "$(json_or_null "$release")" "$(int_or_null "$version")" "$(int_or_null "$data_free")" "$(bool "$data_writable")" "$(int_or_null "$state_free")" \
        "$(int_or_null "$cpus")" "$(json_or_null "$aws_version")" "$(bool "$([[ $aws_version == 2.* ]] && echo 1 || echo 0)")")"
}

# Profiles the administrator defined on this server, with their validity and
# runtime only: the files' paths and settings are never returned.
cmd_source_list() {
    (($# == 0)) || fail invalid_arguments
    local file id out entries='' sep='' count=0 runtime run_as code
    if [[ -d $SOURCES_DIR && ! -L $SOURCES_DIR ]]; then
        while IFS= read -r -d '' file; do
            ((count < 50)) || break
            id=$(basename "$file" .conf)
            [[ $id =~ $SOURCE_RE ]] || continue
            # load_source exits on the first problem; a subshell keeps the listing going.
            out=$(load_source "$id"; printf 'MWT_OK %s %s' "$SRC_RUNTIME" "$SRC_RUN_AS") || true
            if [[ $out =~ ^MWT_OK\ (native|compose)\ ([a-z_][a-z0-9_-]{0,31})$ ]]; then
                runtime=${BASH_REMATCH[1]} run_as=${BASH_REMATCH[2]}
                entries+="$sep{\"id\":\"$id\",\"valid\":true,\"runtime\":\"$runtime\",\"run_as\":\"$run_as\",\"error_code\":null}"
            else
                code=$(sed -n 's/.*"code":"\([a-z_]*\)".*/\1/p' <<<"$out")
                entries+="$sep{\"id\":\"$id\",\"valid\":false,\"runtime\":null,\"run_as\":null,\"error_code\":$(json_or_null "${code:-source_profile_invalid}")}"
            fi
            sep=','
            count=$((count + 1))
        done < <(find "$SOURCES_DIR" -maxdepth 1 -type f -name '*.conf' -print0 | LC_ALL=C sort -z)
    fi
    respond_ok source-list "{\"sources_dir_exists\":$(bool "$([[ -d $SOURCES_DIR ]] && echo 1 || echo 0)"),\"sources\":[$entries]}"
}

cmd_destination_list() {
    (($# == 0)) || fail invalid_arguments
    local file id out entries='' sep='' count=0 code
    if [[ -d $DESTINATIONS_DIR && ! -L $DESTINATIONS_DIR ]]; then
        while IFS= read -r -d '' file; do
