# Checks that a destination profile can run the Consolidator. Reports closed
# facts only: the runtime's .env holds the site's secrets and none of its
# values leave the server, not even to compare them here beyond the URL.
cmd_destination_check() {
    (($# == 1)) || fail invalid_arguments
    local runtime env env_present=0 env_protected=0 env_url='' env_complete=0 tool_present=0 engine_intact=0
    local docker_version='' compose_version='' flock_present=0 cpus='' mem_kb='' free='' target_running=0 written=0 required python_present=0
    local owned=0 docker_group=0 volumes=0 started=0 packages=0 profiles=0
    load_destination "$1"
    runtime=$DST_RUNTIME_DIR
    [[ -d $runtime && ! -L $runtime ]] || fail destination_runtime_missing
    destination_owned && owned=1
    id -nG "$DST_RUN_AS" 2>/dev/null | tr ' ' '\n' | grep -qx docker && docker_group=1
    env="$runtime/.env"
    if [[ -f $env && ! -L $env ]]; then
        env_present=1
        (((8#$(stat -c '%a' "$env") & 8#077) == 0)) && env_protected=1
        env_url=$(sed -n 's/^MOODLE_PUBLIC_URL=\(.*\)$/\1/p' "$env" | head -n 1)
        env_complete=1
        grep -Eq '(^|=)CHANGE_ME($|[[:space:]])' "$env" && env_complete=0
        for required in MOODLE_PUBLIC_URL MOODLE_INTERNAL_HEALTH_URL MOODLE_ADMIN_USER MOODLE_ADMIN_PASSWORD MOODLE_DB_PASSWORD MARIADB_ROOT_PASSWORD MOODLE_MANAGED_CONFIG_DIR; do
            grep -Eq "^${required}=.+" "$env" || env_complete=0
        done
    fi
    compgen -G "$TOOLS_DIR/moodle-consolidador-*/$DST_TOOL_TREE" >/dev/null && tool_present=1
    engine_intact "$runtime" && engine_intact=1
    if command -v docker >/dev/null 2>&1; then
        docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)
        compose_version=$(docker compose version --short 2>/dev/null || true)
        if [[ -n $docker_version && -n $compose_version ]]; then
            docker compose --project-name "$CONSOLIDATOR_COMPOSE_PROJECT" ps --status running --services 2>/dev/null | grep -qx moodle-target && target_running=1
            # Volumes of a previous site: the database and moodledata survive the containers.
            volumes=$(docker volume ls -q --filter "label=com.docker.compose.project=$CONSOLIDATOR_COMPOSE_PROJECT" 2>/dev/null | wc -l)
        fi
    fi
    command -v flock >/dev/null 2>&1 && flock_present=1
    command -v python3 >/dev/null 2>&1 && python_present=1
    cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '')
    [[ -r /proc/meminfo ]] && mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    free=$(df -PB1 "$runtime" 2>/dev/null | awk 'NR==2 {print $4}') || free=''
    [[ -f $runtime/reports/destination-write.lock.json ]] && written=1
    [[ -f $runtime/reports/assistant-state.json ]] && started=1
    packages=$(find "$runtime/copias" -maxdepth 1 -type f -name '*.zip' 2>/dev/null | wc -l)
    profiles=$(find "$DESTINATIONS_DIR" -maxdepth 1 -type f -name '*.conf' 2>/dev/null | wc -l)
    respond_ok destination-check "$(printf '{"destination":"%s","public_url":%s,"env_present":%s,"env_protected":%s,"env_matches_url":%s,"env_complete":%s,"tool_tree":"%s","tool_present":%s,"engine_intact":%s,"docker_version":%s,"compose_version":%s,"flock":%s,"python3":%s,"cpus":%s,"memory_bytes":%s,"runtime_free_bytes":%s,"target_running":%s,"destination_written":%s,"run_as":"%s","run_as_docker":%s,"runtime_owned":%s,"target_volumes":%s,"assistant_started":%s,"copias_packages":%s,"server_profiles":%s}' \
        "$DST_ID" "$(json_escape "$DST_PUBLIC_URL")" "$(bool "$env_present")" "$(bool "$env_protected")" \
        "$(bool "$([[ -n $env_url && $env_url == "$DST_PUBLIC_URL" ]] && echo 1 || echo 0)")" "$(bool "$env_complete")" \
        "$DST_TOOL_TREE" "$(bool "$tool_present")" "$(bool "$engine_intact")" "$(json_or_null "$docker_version")" \
        "$(json_or_null "$compose_version")" "$(bool "$flock_present")" "$(bool "$python_present")" "$(int_or_null "$cpus")" \
        "$(if [[ $mem_kb =~ ^[0-9]+$ ]]; then printf '%s' $((mem_kb * 1024)); else printf 'null'; fi)" \
        "$(int_or_null "$free")" "$(bool "$target_running")" "$(bool "$written")" "$DST_RUN_AS" "$(bool "$docker_group")" "$(bool "$owned")"         "$volumes" "$(bool "$started")" "$packages" "$profiles")"
}

# Sets PKG_* for a finished collector.742 operation whose ZIP matches its sidecar.
collector_package() {
    local launch exit_file
    require_operation "$1"
    PKG_OP_DIR=$OP_DIR
    launch="$PKG_OP_DIR/launch.json"
    exit_file="$PKG_OP_DIR/exit.json"
    [[ -f $launch ]] || fail collector_operation_not_found
    [[ $(sed -n 's/.*"command_key":"\([^"]*\)".*/\1/p' "$launch") == collector.742 ]] || fail not_a_collector_operation
    [[ -f $exit_file ]] && grep -q '"exit_code":0,' "$exit_file" || fail collector_not_succeeded
    PKG_NAME=$(sed -n 's/.*"package":"\([a-z][a-z0-9_-]*\)".*/\1/p' "$launch")
    PKG_SOURCE=$(sed -n 's/.*"source":"\([a-z0-9][a-z0-9-]*\)".*/\1/p' "$launch")
    PKG_TOOL_SHA=$(sed -n 's/.*"distribution":"\([0-9a-f]\{64\}\)".*/\1/p' "$launch")
    [[ -n $PKG_NAME && -n $PKG_SOURCE && -n $PKG_TOOL_SHA ]] || fail launch_evidence_invalid
    PKG_OUTPUT="$PKG_OP_DIR/work/output"
    PKG_ZIP="$PKG_OUTPUT/$PKG_NAME.zip"
    PKG_SIDECAR="$PKG_ZIP.sha256"
    [[ -f $PKG_ZIP && ! -L $PKG_ZIP && -f $PKG_SIDECAR && ! -L $PKG_SIDECAR ]] || fail package_not_found
    PKG_SHA=$(head -n 1 "$PKG_SIDECAR" | cut -c1-64)
    [[ $PKG_SHA =~ $SHA_RE && $(head -n 1 "$PKG_SIDECAR") == "$PKG_SHA  $PKG_NAME.zip" ]] || fail sidecar_invalid
}

# Internal step of package.upload, run by systemd. Re-verifies the package, audits
# it with the deployed validator in the source runtime, extracts the manifest and
# uploads the four objects with the instance's own credentials.
cmd_package_upload_internal() {
    local collector=$1 project=$2 bucket=$3 region=$4 op_dir=$5 tool audit actual size prefix
    [[ $collector =~ $UUID_RE && $project =~ $UUID_RE && $bucket =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ && $op_dir == "$OPS_DIR/"* ]] || exit 40
    collector_package "$collector" >/dev/null
    actual=$(sha256sum "$PKG_ZIP" | cut -c1-64)
    [[ $actual == "$PKG_SHA" ]] || { echo "PACKAGE_HASH_MISMATCH" >&2; exit 41; }
    size=$(stat -c %s "$PKG_ZIP")
    tool="$TOOLS_DIR/$COLLECTOR_TOOL_KEY/$PKG_TOOL_SHA"
    [[ $(tree_hash "$tool") == "$PKG_TOOL_SHA" ]] || { echo "TOOL_HASH_MISMATCH" >&2; exit 42; }
    load_source "$PKG_SOURCE" >/dev/null
    audit="$op_dir/work/audit"
    chmod 0711 "$op_dir"
    install -d -o "$SRC_RUN_AS" -g "$SRC_RUN_AS" -m 0700 "$op_dir/work" "$audit"
    source_exec "$tool:ro" "$PKG_OUTPUT:ro" "$audit"
    "${SRC_EXEC[@]}" php "$tool/scripts/validate-package.php" "--zip=$PKG_ZIP" "--sidecar=$PKG_SIDECAR" "--report=$audit/validation.json" \
        || { echo "PACKAGE_VALIDATION_FAILED" >&2; exit 43; }
    grep -Eq '"result": ?"ok"' "$audit/validation.json" || { echo "PACKAGE_VALIDATION_FAILED" >&2; exit 43; }
    # shellcheck disable=SC2016
    "${SRC_EXEC[@]}" php -r '$zip = new ZipArchive; if ($zip->open($argv[1], ZipArchive::RDONLY) !== true) exit(2);
        $manifest = $zip->getFromName("manifest.json", 1048577); if (!is_string($manifest) || strlen($manifest) > 1048576) exit(3);
        exit(file_put_contents($argv[2], $manifest) === strlen($manifest) ? 0 : 4);' "$PKG_ZIP" "$audit/manifest.json" \
        || { echo "MANIFEST_UNAVAILABLE" >&2; exit 44; }
    prefix="mwt/$project/$PKG_SOURCE/$PKG_SHA"
    aws s3 cp "$PKG_ZIP" "s3://$bucket/$prefix.zip" --region "$region" --only-show-errors --sse AES256 \
        --checksum-algorithm SHA256 --metadata "mwt-sha256=$PKG_SHA,mwt-source=$PKG_SOURCE,mwt-project=$project" \
        || { echo "UPLOAD_FAILED" >&2; exit 45; }
    local object source_file
    for object in zip.sha256 manifest.json validation.json; do
        case $object in
            zip.sha256) source_file=$PKG_SIDECAR ;;
            manifest.json) source_file=$audit/manifest.json ;;
            validation.json) source_file=$audit/validation.json ;;
        esac
        aws s3 cp "$source_file" "s3://$bucket/$prefix.$object" --region "$region" --only-show-errors --sse AES256 \
            --checksum-algorithm SHA256 --metadata "mwt-sha256=$(sha256sum "$source_file" | cut -c1-64)" \
            || { echo "UPLOAD_FAILED" >&2; exit 45; }
    done
    write_atomic "$op_dir/work/result.json" "$(printf '{"bucket":"%s","region":"%s","prefix":"%s","package":"%s","source":"%s","sha256":"%s","size":%s,"manifest_sha256":"%s","validation_sha256":"%s","uploaded_at":"%s"}' \
        "$bucket" "$region" "$prefix" "$PKG_NAME" "$PKG_SOURCE" "$PKG_SHA" "$size" \
        "$(sha256sum "$audit/manifest.json" | cut -c1-64)" "$(sha256sum "$audit/validation.json" | cut -c1-64)" "$(now_utc)")"
    echo "UPLOAD_OK"
}

