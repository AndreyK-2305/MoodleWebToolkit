# Checks that a destination profile can run the Consolidator. Reports closed
# facts only: the runtime's .env holds the site's secrets and none of its
# values leave the server, not even to compare them here beyond the URL.
cmd_destination_check() {
    (($# == 1)) || fail invalid_arguments
    local runtime env env_present=0 env_protected=0 env_url='' env_complete=0 tool_present=0 engine_intact=0
    local docker_version='' compose_version='' flock_present=0 cpus='' mem_kb='' free='' target_running=0 written=0 required python_present=0
    load_destination "$1"
    runtime=$DST_RUNTIME_DIR
    [[ -d $runtime && ! -L $runtime ]] || fail destination_runtime_missing
    if [[ $(id -u) == 0 ]]; then
        [[ $(stat -c %u "$runtime") == 0 ]] || fail destination_profile_unsafe
    fi
    env="$runtime/.env"
    if [[ -f $env && ! -L $env ]]; then
        env_present=1
        (((8#$(stat -c '%a' "$env") & 8#077) == 0)) && env_protected=1
        env_url=$(sed -n 's/^MOODLE_PUBLIC_URL=\(.*\)$/\1/p' "$env" | head -n 1)
        env_complete=1
        grep -Eq '(^|=)CHANGE_ME($|[[:space:]])' "$env" && env_complete=0
        for required in MOODLE_PUBLIC_URL MOODLE_INTERNAL_HEALTH_URL MOODLE_ADMIN_USER MOODLE_ADMIN_PASSWORD MOODLE_DB_PASSWORD MARIADB_ROOT_PASSWORD MOODLE_MANAGED_CONFIG_DIR; do
            grep -Eq "^${required}=.+" "$env" || env_complete=0
        done
    fi
    compgen -G "$TOOLS_DIR/moodle-consolidador-*/$DST_TOOL_TREE" >/dev/null && tool_present=1
    engine_intact "$runtime" && engine_intact=1
    if command -v docker >/dev/null 2>&1; then
        docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)
        compose_version=$(docker compose version --short 2>/dev/null || true)
        if [[ -n $docker_version && -n $compose_version ]]; then
            docker compose --project-name "$CONSOLIDATOR_COMPOSE_PROJECT" ps --status running --services 2>/dev/null | grep -qx moodle-target && target_running=1
        fi
    fi
    command -v flock >/dev/null 2>&1 && flock_present=1
    command -v python3 >/dev/null 2>&1 && python_present=1
    cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '')
    [[ -r /proc/meminfo ]] && mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    free=$(df -PB1 "$runtime" 2>/dev/null | awk 'NR==2 {print $4}') || free=''
    [[ -f $runtime/reports/destination-write.lock.json ]] && written=1
    respond_ok destination-check "$(printf '{"destination":"%s","public_url":%s,"env_present":%s,"env_protected":%s,"env_matches_url":%s,"env_complete":%s,"tool_tree":"%s","tool_present":%s,"engine_intact":%s,"docker_version":%s,"compose_version":%s,"flock":%s,"python3":%s,"cpus":%s,"memory_bytes":%s,"runtime_free_bytes":%s,"target_running":%s,"destination_written":%s}' \
        "$DST_ID" "$(json_escape "$DST_PUBLIC_URL")" "$(bool "$env_present")" "$(bool "$env_protected")" \
        "$(bool "$([[ -n $env_url && $env_url == "$DST_PUBLIC_URL" ]] && echo 1 || echo 0)")" "$(bool "$env_complete")" \
        "$DST_TOOL_TREE" "$(bool "$tool_present")" "$(bool "$engine_intact")" "$(json_or_null "$docker_version")" \
        "$(json_or_null "$compose_version")" "$(bool "$flock_present")" "$(bool "$python_present")" "$(int_or_null "$cpus")" \
        "$(if [[ $mem_kb =~ ^[0-9]+$ ]]; then printf '%s' $((mem_kb * 1024)); else printf 'null'; fi)" \
        "$(int_or_null "$free")" "$(bool "$target_running")" "$(bool "$written")")"
}

# Sets PKG_* for a finished collector.742 operation whose ZIP matches its sidecar.
collector_package() {
    local launch exit_file
    require_operation "$1"
    PKG_OP_DIR=$OP_DIR
    launch="$PKG_OP_DIR/launch.json"
    exit_file="$PKG_OP_DIR/exit.json"
    [[ -f $launch ]] || fail collector_operation_not_found
    [[ $(sed -n 's/.*"command_key":"\([^"]*\)".*/\1/p' "$launch") == collector.742 ]] || fail not_a_collector_operation
    [[ -f $exit_file ]] && grep -q '"exit_code":0,' "$exit_file" || fail collector_not_succeeded
    PKG_NAME=$(sed -n 's/.*"package":"\([a-z][a-z0-9_-]*\)".*/\1/p' "$launch")
    PKG_SOURCE=$(sed -n 's/.*"source":"\([a-z0-9][a-z0-9-]*\)".*/\1/p' "$launch")
    PKG_TOOL_SHA=$(sed -n 's/.*"distribution":"\([0-9a-f]\{64\}\)".*/\1/p' "$launch")
    [[ -n $PKG_NAME && -n $PKG_SOURCE && -n $PKG_TOOL_SHA ]] || fail launch_evidence_invalid
    PKG_OUTPUT="$PKG_OP_DIR/work/output"
    PKG_ZIP="$PKG_OUTPUT/$PKG_NAME.zip"
    PKG_SIDECAR="$PKG_ZIP.sha256"
    [[ -f $PKG_ZIP && ! -L $PKG_ZIP && -f $PKG_SIDECAR && ! -L $PKG_SIDECAR ]] || fail package_not_found
    PKG_SHA=$(head -n 1 "$PKG_SIDECAR" | cut -c1-64)
    [[ $PKG_SHA =~ $SHA_RE && $(head -n 1 "$PKG_SIDECAR") == "$PKG_SHA  $PKG_NAME.zip" ]] || fail sidecar_invalid
}

# Internal step of package.upload, run by systemd. Re-verifies the package, audits
# it with the deployed validator in the source runtime, extracts the manifest and
# uploads the four objects with the instance's own credentials.
cmd_package_upload_internal() {
    local collector=$1 project=$2 bucket=$3 region=$4 op_dir=$5 tool audit actual size prefix
    [[ $collector =~ $UUID_RE && $project =~ $UUID_RE && $bucket =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ && $op_dir == "$OPS_DIR/"* ]] || exit 40
    collector_package "$collector" >/dev/null
    actual=$(sha256sum "$PKG_ZIP" | cut -c1-64)
    [[ $actual == "$PKG_SHA" ]] || { echo "PACKAGE_HASH_MISMATCH" >&2; exit 41; }
    size=$(stat -c %s "$PKG_ZIP")
    tool="$TOOLS_DIR/$COLLECTOR_TOOL_KEY/$PKG_TOOL_SHA"
    [[ $(tree_hash "$tool") == "$PKG_TOOL_SHA" ]] || { echo "TOOL_HASH_MISMATCH" >&2; exit 42; }
    load_source "$PKG_SOURCE" >/dev/null
    audit="$op_dir/work/audit"
    chmod 0711 "$op_dir"
    install -d -o "$SRC_RUN_AS" -g "$SRC_RUN_AS" -m 0700 "$op_dir/work" "$audit"
    source_exec "$tool:ro" "$PKG_OUTPUT:ro" "$audit"
    "${SRC_EXEC[@]}" php "$tool/scripts/validate-package.php" "--zip=$PKG_ZIP" "--sidecar=$PKG_SIDECAR" "--report=$audit/validation.json" \
        || { echo "PACKAGE_VALIDATION_FAILED" >&2; exit 43; }
    grep -Eq '"result": ?"ok"' "$audit/validation.json" || { echo "PACKAGE_VALIDATION_FAILED" >&2; exit 43; }
    # shellcheck disable=SC2016
    "${SRC_EXEC[@]}" php -r '$zip = new ZipArchive; if ($zip->open($argv[1], ZipArchive::RDONLY) !== true) exit(2);
        $manifest = $zip->getFromName("manifest.json", 1048577); if (!is_string($manifest) || strlen($manifest) > 1048576) exit(3);
        exit(file_put_contents($argv[2], $manifest) === strlen($manifest) ? 0 : 4);' "$PKG_ZIP" "$audit/manifest.json" \
        || { echo "MANIFEST_UNAVAILABLE" >&2; exit 44; }
    prefix="mwt/$project/$PKG_SOURCE/$PKG_SHA"
    aws s3 cp "$PKG_ZIP" "s3://$bucket/$prefix.zip" --region "$region" --only-show-errors --sse AES256 \
        --checksum-algorithm SHA256 --metadata "mwt-sha256=$PKG_SHA,mwt-source=$PKG_SOURCE,mwt-project=$project" \
        || { echo "UPLOAD_FAILED" >&2; exit 45; }
    local object source_file
    for object in zip.sha256 manifest.json validation.json; do
        case $object in
            zip.sha256) source_file=$PKG_SIDECAR ;;
            manifest.json) source_file=$audit/manifest.json ;;
            validation.json) source_file=$audit/validation.json ;;
        esac
        aws s3 cp "$source_file" "s3://$bucket/$prefix.$object" --region "$region" --only-show-errors --sse AES256 \
            --checksum-algorithm SHA256 --metadata "mwt-sha256=$(sha256sum "$source_file" | cut -c1-64)" \
            || { echo "UPLOAD_FAILED" >&2; exit 45; }
    done
    write_atomic "$op_dir/work/result.json" "$(printf '{"bucket":"%s","region":"%s","prefix":"%s","package":"%s","source":"%s","sha256":"%s","size":%s,"manifest_sha256":"%s","validation_sha256":"%s","uploaded_at":"%s"}' \
        "$bucket" "$region" "$prefix" "$PKG_NAME" "$PKG_SOURCE" "$PKG_SHA" "$size" \
        "$(sha256sum "$audit/manifest.json" | cut -c1-64)" "$(sha256sum "$audit/validation.json" | cut -c1-64)" "$(now_utc)")"
    echo "UPLOAD_OK"
}

cmd_upload_report() {
    (($# == 1)) || fail invalid_arguments
    require_operation "$1"
    [[ -f $OP_DIR/launch.json ]] || fail operation_not_found 4
    [[ $(sed -n 's/.*"command_key":"\([^"]*\)".*/\1/p' "$OP_DIR/launch.json") == package.upload ]] || fail not_an_upload_operation
    respond_ok upload-report "{\"operation_uuid\":\"$1\",\"result_base64\":$(encode_document "$OP_DIR/work/result.json")}"
}

# Bounded base64 of a structured document, "too_large" or null when absent.
# Brings one sealed package from S3 into the destination runtime's copias/: the
# sidecar first, then the ZIP, both into a staging directory on the same
# filesystem. Nothing reaches copias/ until the ZIP hashes as the platform
# expects and as its own sidecar declares; the sidecar is moved last.
cmd_package_fetch_internal() {
    local destination=$1 project=$2 source=$3 sha=$4 bucket=$5 region=$6 op_dir=$7 copias staging prefix line name size free actual
    [[ $project =~ $UUID_RE && $sha =~ $SHA_RE && $op_dir == "$OPS_DIR/"* ]] || exit 50
    load_destination "$destination" >/dev/null
    [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || { echo "DESTINATION_ALREADY_WRITTEN" >&2; exit 51; }
    copias="$DST_RUNTIME_DIR/copias"
    [[ ! -L $copias ]] || exit 50
    mkdir -p "$copias" "$op_dir/work"
    staging="$copias/.incoming-$(basename "$op_dir")"
    rm -rf -- "$staging"
    mkdir -m 0700 "$staging"
    # Expanded now: the trap runs after this function's locals are gone.
    # shellcheck disable=SC2064
    trap "rm -rf -- $(printf '%q' "$staging")" EXIT
    prefix="mwt/$project/$source/$sha"
    aws s3 cp "s3://$bucket/$prefix.zip.sha256" "$staging/sidecar" --region "$region" --only-show-errors \
        || { echo "SIDECAR_DOWNLOAD_FAILED" >&2; exit 52; }
    line=$(head -c 512 "$staging/sidecar" | head -n 1 | tr -d '\r')
    [[ $line =~ ^([0-9a-f]{64})\ [\ *]?([a-z][a-z0-9_-]{0,63}\.zip)$ && ${BASH_REMATCH[1]} == "$sha" ]] || { echo "SIDECAR_INVALID" >&2; exit 53; }
    name=${BASH_REMATCH[2]}
    if [[ -f $copias/$name && ! -L $copias/$name ]]; then
        # Same name already there: only the very same package counts as present.
        [[ $(sha256sum "$copias/$name" | cut -c1-64) == "$sha" ]] || { echo "DESTINATION_NAME_CONFLICT" >&2; exit 54; }
        cp "$staging/sidecar" "$copias/$name.sha256.tmp" && mv -f "$copias/$name.sha256.tmp" "$copias/$name.sha256"
        size=$(stat -c %s "$copias/$name")
        write_atomic "$op_dir/work/result.json" "$(printf '{"name":"%s","sha256":"%s","size":%s,"already_present":true,"fetched_at":"%s"}' "$name" "$sha" "$size" "$(now_utc)")"
        echo "FETCH_OK name=$name already_present=1"
        exit 0
    fi
    [[ ! -e $copias/$name ]] || { echo "DESTINATION_NAME_CONFLICT" >&2; exit 54; }
    size=$(aws s3api head-object --bucket "$bucket" --key "$prefix.zip" --region "$region" --query ContentLength --output text 2>/dev/null) || size=''
    [[ $size =~ ^[0-9]+$ ]] || { echo "PACKAGE_NOT_FOUND" >&2; exit 55; }
    free=$(df -PB1 "$copias" | awk 'NR==2 {print $4}')
    # The ZIP plus a tenth of margin; the Consolidator sizes its own extraction later.
    ((free > size + size / 10)) || { echo "INSUFFICIENT_DISK" >&2; exit 56; }
    aws s3 cp "s3://$bucket/$prefix.zip" "$staging/$name" --region "$region" --only-show-errors \
        || { echo "PACKAGE_DOWNLOAD_FAILED" >&2; exit 57; }
    actual=$(sha256sum "$staging/$name" | cut -c1-64)
    [[ $actual == "$sha" && $(stat -c %s "$staging/$name") == "$size" ]] || { echo "PACKAGE_HASH_MISMATCH" >&2; exit 58; }
    chmod 0644 "$staging/$name" "$staging/sidecar"
    mv "$staging/$name" "$copias/$name"
    mv "$staging/sidecar" "$copias/$name.sha256"
    write_atomic "$op_dir/work/result.json" "$(printf '{"name":"%s","sha256":"%s","size":%s,"already_present":false,"fetched_at":"%s"}' "$name" "$sha" "$size" "$(now_utc)")"
    echo "FETCH_OK name=$name already_present=0"
}

cmd_fetch_report() {
    (($# == 1)) || fail invalid_arguments
    require_operation "$1"
    [[ -f $OP_DIR/launch.json ]] || fail operation_not_found 4
    [[ $(sed -n 's/.*"command_key":"\([^"]*\)".*/\1/p' "$OP_DIR/launch.json") == package.fetch ]] || fail not_a_fetch_operation
    respond_ok fetch-report "{\"operation_uuid\":\"$1\",\"result_base64\":$(encode_document "$OP_DIR/work/result.json")}"
}

# The packages in a destination runtime's copias/: name, size and what its
# sidecar declares. ZIPs are not hashed again here; the fetch verified them.
cmd_copias_list() {
    (($# == 1)) || fail invalid_arguments
    local copias file name entries='' sep='' count=0 sidecar_sha size line
    load_destination "$1"
    copias="$DST_RUNTIME_DIR/copias"
    [[ ! -L $copias ]] || fail destination_profile_unsafe
    if [[ -d $copias ]]; then
        while IFS= read -r -d '' file; do
            ((count < 64)) || break
            name=$(basename "$file")
            [[ $name =~ ^[a-z][a-z0-9_-]{0,63}\.zip$ ]] || continue
            size=$(stat -c %s "$file")
            sidecar_sha=''
            if [[ -f $file.sha256 && ! -L $file.sha256 ]]; then
                line=$(head -c 512 "$file.sha256" | head -n 1 | tr -d '\r')
                [[ $line =~ ^([0-9a-f]{64})\ [\ *]?([a-z][a-z0-9_-]{0,63}\.zip)$ && ${BASH_REMATCH[2]} == "$name" ]] && sidecar_sha=${BASH_REMATCH[1]}
            fi
            entries+="$sep{\"name\":\"$name\",\"size\":$size,\"sidecar_sha256\":$(json_or_null "$sidecar_sha")}"
            sep=','
            count=$((count + 1))
        done < <(find "$copias" -maxdepth 1 -type f -name '*.zip' -print0 | LC_ALL=C sort -z)
    fi
    respond_ok copias-list "{\"destination\":\"$1\",\"write_locked\":$(bool "$([[ -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] && echo 1 || echo 0)"),\"packages\":[$entries]}"
}

# Removes one package from copias/ while the destination has not been written.
cmd_copias_remove() {
    (($# == 2)) || fail invalid_arguments
    local copias name=$2
    [[ $name =~ ^[a-z][a-z0-9_-]{0,63}\.zip$ ]] || fail invalid_arguments
    load_destination "$1"
    [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_already_written
    copias="$DST_RUNTIME_DIR/copias"
    [[ ! -L $copias && ! -L $copias/$name && ! -L $copias/$name.sha256 ]] || fail destination_profile_unsafe
    [[ -f $copias/$name ]] || fail package_not_found
    rm -f -- "$copias/$name" "$copias/$name.sha256"
    respond_ok copias-remove "{\"destination\":\"$1\",\"name\":\"$name\",\"removed\":true}"
}

# The Consolidator's own state documents for one destination: the assistant's
# stage and status, the parallel workers' snapshot and the closing summaries.
# They are returned as written by the Consolidator; the platform keeps only
# whitelisted fields and never interprets console text.
cmd_consolidator_report() {
    (($# == 1)) || fail invalid_arguments
    local runtime
    load_destination "$1"
    runtime=$DST_RUNTIME_DIR
    [[ -d $runtime && ! -L $runtime && ! -L $runtime/reports && ! -L $runtime/exports ]] || fail destination_runtime_missing
    respond_ok consolidator-report "$(printf '{"destination":"%s","write_locked":%s,"assistant_state_base64":%s,"workers_status_base64":%s,"closure_summary_base64":%s,"site_package_summary_base64":%s,"observed_at":"%s"}' \
        "$1" "$(bool "$([[ -e $runtime/reports/destination-write.lock.json ]] && echo 1 || echo 0)")" \
        "$(encode_document "$runtime/reports/assistant-state.json")" "$(encode_document "$runtime/reports/fase-6-workers-status.json")" \
        "$(encode_document "$runtime/exports/phase7/closure_summary.json")" "$(encode_document "$runtime/exports/phase8/site_package_summary.json")" \
        "$(now_utc)")"
}

# The Consolidator's own documents for one kind of intervention, bounded so the
# answer always fits one call. The platform keeps whitelisted fields only.
cmd_consolidator_intervention() {
    (($# == 2)) || fail invalid_arguments
    local runtime kind=$2 name entries='' sep='' file
    load_destination "$1"
    runtime=$DST_RUNTIME_DIR
    [[ -d $runtime && ! -L $runtime && ! -L $runtime/reports && ! -L $runtime/exports ]] || fail destination_runtime_missing
    local -a documents
    case $kind in
        oauth2) documents=(oauth2_manual=reports/oauth2-configuracion-manual.txt oauth2_validation=exports/oauth2/validation.json
            oauth2_live=exports/oauth2-live/validation.json) ;;
        plugins) documents=(plugin_needs=exports/phase2/plugin_compatibility_needs.json plugin_diff=exports/phase2/plugin_inventory_diff.json
            plugin_technical=exports/phase2/plugin_technical_validation.json plugin_checkpoint=exports/phase2/plugin_intervention_checkpoint.json) ;;
        *) fail invalid_arguments ;;
    esac
    for name in "${documents[@]}"; do
        file="$runtime/${name#*=}"
        if [[ -f $file && ! -L $file ]] && (($(stat -c %s "$file") <= 10240)); then
            entries+="$sep\"${name%%=*}\":\"$(base64 -w0 <"$file")\""
        else
            entries+="$sep\"${name%%=*}\":$([[ -f $file ]] && printf '"too_large"' || printf 'null')"
        fi
        sep=','
    done
    respond_ok consolidator-intervention "{\"destination\":\"$1\",\"kind\":\"$kind\",\"documents\":{$entries}}"
}

encode_document() {
    if [[ -f $1 && ! -L $1 ]]; then
        if (($(stat -c %s "$1") > 16384)); then printf '"too_large"'; else printf '"%s"' "$(base64 -w0 <"$1")"; fi
    else
        printf 'null'
    fi
}

# Structured Collector state for one collector.742 operation: the raw status and
# progress documents plus the output listing and the SHA-256 sidecar line. The
# platform keeps only whitelisted fields; console text is never interpreted.
cmd_collector_report() {
    (($# == 1)) || fail invalid_arguments
    local dir package output sidecar_line='' outputs='' sep='' name size count=0
    require_operation "$1"
    dir=$OP_DIR
    [[ -f $dir/launch.json ]] || fail operation_not_found 4
    [[ $(sed -n 's/.*"command_key":"\([^"]*\)".*/\1/p' "$dir/launch.json") == collector.742 ]] || fail not_a_collector_operation
    package=$(sed -n 's/.*"package":"\([a-z][a-z0-9_-]*\)".*/\1/p' "$dir/launch.json")
    [[ -n $package ]] || fail launch_evidence_invalid
    output="$dir/work/output"
    if [[ -d $output && ! -L $output ]]; then
        while IFS=$'\t' read -r name size; do
            [[ $name =~ ^[A-Za-z0-9._-]{1,128}$ && $size =~ ^[0-9]+$ ]] || continue
            ((count < 50)) || break
            outputs+="$sep{\"name\":\"$name\",\"size\":$size}"
            sep=','
            count=$((count + 1))
        done < <(find "$output" -maxdepth 1 -type f -printf '%f\t%s\n' | LC_ALL=C sort)
        if [[ -f $output/$package.zip.sha256 && ! -L $output/$package.zip.sha256 ]] && (($(stat -c %s "$output/$package.zip.sha256") <= 256)); then
            sidecar_line=$(head -n 1 "$output/$package.zip.sha256")
            [[ $sidecar_line =~ ^[0-9a-f]{64}\ \ [a-z][a-z0-9_-]*\.zip$ ]] || sidecar_line=''
        fi
    fi
    respond_ok collector-report "$(printf '{"operation_uuid":"%s","package":"%s","status_base64":%s,"progress_base64":%s,"outputs":[%s],"sidecar":%s,"observed_at":"%s"}' \
        "$1" "$package" "$(encode_document "$output/$package.status.json")" \
        "$(encode_document "$output/.moodle-collector-work-$package/export-progress.json")" \
        "$outputs" "$(json_or_null "$sidecar_line")" "$(now_utc)")"
}

# Frees the disk a finished operation used on the server. Only the heavy
# outputs go (the package ZIP, the Collector's working tree and temporary
# files, the upload audit copy); launch, exit, logs, the SHA-256 sidecar and
# the status document stay as evidence. Never touches a running operation,
# never follows a link and never crosses into another filesystem.
cmd_cleanup() {
    (($# == 1)) || fail invalid_arguments
    local uuid=$1 dir launcher load='' active='' sub='' main_pid='' run_pid='' key package before=0 after=0 target freed
    local -a targets=()
    require_operation "$uuid"
    dir=$OP_DIR
    [[ -f $dir/launch.json ]] || fail operation_not_found 4
    if [[ -f $dir/cleanup.json ]]; then
        respond_ok cleanup "{\"operation_uuid\":\"$uuid\",\"already_clean\":true,\"cleanup\":$(cat "$dir/cleanup.json")}"
    fi
    [[ -f $dir/exit.json ]] || fail operation_active
    launcher=$(sed -n 's/.*"launcher":"\([a-z]*\)".*/\1/p' "$dir/launch.json")
    if [[ $launcher == systemd ]]; then
        read -r load active sub main_pid < <(unit_state "mwt-op-${uuid}" || printf '\n') || true
        [[ $active == active || $active == activating || $active == deactivating ]] && fail operation_active
    else
        [[ -f $dir/run.json ]] && run_pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$dir/run.json")
        [[ -n $run_pid ]] && kill -0 "$run_pid" 2>/dev/null && fail operation_active
    fi
    key=$(sed -n 's/.*"command_key":"\([^"]*\)".*/\1/p' "$dir/launch.json")
    case $key in
        collector.742)
            package=$(sed -n 's/.*"package":"\([a-z][a-z0-9_-]*\)".*/\1/p' "$dir/launch.json")
            [[ -n $package ]] || fail launch_evidence_invalid
            targets=("$dir/work/tmp" "$dir/work/output/$package.zip" "$dir/work/output/.moodle-collector-work-$package")
            ;;
        package.upload) targets=("$dir/work/audit") ;;
    esac
    [[ ! -L $dir/work && ! -L $dir/work/output ]] || fail cleanup_unsafe_path
    [[ -d $dir/work ]] && before=$(du -sb --one-file-system "$dir/work" | cut -f1)
    # Every target is checked before anything is removed: a link anywhere means nothing is touched.
    for target in "${targets[@]}"; do
        [[ ! -L $target ]] || fail cleanup_unsafe_path
    done
    for target in "${targets[@]}"; do
        [[ -e $target ]] && rm -rf --one-file-system -- "$target"
    done
    [[ -d $dir/work ]] && after=$(du -sb --one-file-system "$dir/work" | cut -f1)
    freed=$((before - after))
    ((freed >= 0)) || freed=0
    write_atomic "$dir/cleanup.json" "$(printf '{"cleaned_at":"%s","freed_bytes":%s,"command_key":"%s"}' "$(now_utc)" "$freed" "$key")"
    respond_ok cleanup "{\"operation_uuid\":\"$uuid\",\"already_clean\":false,\"cleanup\":$(cat "$dir/cleanup.json")}"
}

COMMAND=${1:-}
shift || true
case $COMMAND in
    version) (($# == 0)) || fail invalid_arguments; cmd_version ;;
    probe) (($# == 0)) || fail invalid_arguments; cmd_probe ;;
    launch) cmd_launch "$@" ;;
    status) cmd_status "$@" ;;
    tail) cmd_tail "$@" ;;
    cancel) cmd_cancel "$@" ;;
    tool-status) cmd_tool_status "$@" ;;
    tool-commit) cmd_tool_commit "$@" ;;
    source-check) cmd_source_check "$@" ;;
    source-list) cmd_source_list "$@" ;;
    destination-list) cmd_destination_list "$@" ;;
    destination-check) cmd_destination_check "$@" ;;
    fetch-report) cmd_fetch_report "$@" ;;
    copias-list) cmd_copias_list "$@" ;;
    copias-remove) cmd_copias_remove "$@" ;;
    consolidator-report) cmd_consolidator_report "$@" ;;
    consolidator-intervention) cmd_consolidator_intervention "$@" ;;
    collector-report) cmd_collector_report "$@" ;;
    upload-report) cmd_upload_report "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    __package-upload) (($# == 5)) || exit 40; cmd_package_upload_internal "$@" ;;
    __package-fetch) (($# == 7)) || exit 50; cmd_package_fetch_internal "$@" ;;
    __run) (($# == 1)) || exit 3; cmd_run "$1" ;;
    *) fail unknown_subcommand ;;
esac
