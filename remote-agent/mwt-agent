# The packages in a destination runtime's copias/: name, size and what its
# sidecar declares. ZIPs are not hashed again here; the fetch verified them.
cmd_copias_list() {
    (($# == 1)) || fail invalid_arguments
    local copias file name entries='' sep='' count=0 sidecar_sha size line
    load_destination "$1"
    copias="$DST_RUNTIME_DIR/copias"
    [[ ! -L $copias ]] || fail destination_profile_unsafe
    if [[ -d $copias ]]; then
        while IFS= read -r -d '' file; do
            ((count < 64)) || break
            name=$(basename "$file")
            [[ $name =~ ^[a-z][a-z0-9_-]{0,63}\.zip$ ]] || continue
            size=$(stat -c %s "$file")
            sidecar_sha=''
            if [[ -f $file.sha256 && ! -L $file.sha256 ]]; then
                line=$(head -c 512 "$file.sha256" | head -n 1 | tr -d '\r')
                [[ $line =~ ^([0-9a-f]{64})\ [\ *]?([a-z][a-z0-9_-]{0,63}\.zip)$ && ${BASH_REMATCH[2]} == "$name" ]] && sidecar_sha=${BASH_REMATCH[1]}
            fi
            entries+="$sep{\"name\":\"$name\",\"size\":$size,\"sidecar_sha256\":$(json_or_null "$sidecar_sha")}"
            sep=','
            count=$((count + 1))
        done < <(find "$copias" -maxdepth 1 -type f -name '*.zip' -print0 | LC_ALL=C sort -z)
    fi
    respond_ok copias-list "{\"destination\":\"$1\",\"write_locked\":$(bool "$([[ -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] && echo 1 || echo 0)"),\"packages\":[$entries]}"
}

# Removes one package from copias/ while the destination has not been written.
