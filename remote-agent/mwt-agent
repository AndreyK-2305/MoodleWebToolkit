# Frees the source ZIPs in copias/ once the Consolidator wrote to the site: they
# are already published in S3 and the Consolidator never imports them again.
cmd_copias_release() {
    (($# == 1)) || fail invalid_arguments
    local copias file freed=0 count=0
    load_destination "$1"
    [[ -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || fail destination_not_written
    copias="$DST_RUNTIME_DIR/copias"
    [[ ! -L $copias ]] || fail destination_profile_unsafe
    if [[ -d $copias ]]; then
        while IFS= read -r -d '' file; do
            freed=$((freed + $(stat -c %s "$file")))
            count=$((count + 1))
            rm -f -- "$file" "$file.sha256"
        done < <(find "$copias" -maxdepth 1 -type f -name '*.zip' -print0)
    fi
    respond_ok copias-release "{\"destination\":\"$1\",\"released\":$count,\"freed_bytes\":$freed}"
}

