# Bounded base64 of a structured document, "too_large" or null when absent.
# Brings one sealed package from S3 into the destination runtime's copias/: the
# sidecar first, then the ZIP, both into a staging directory on the same
# filesystem. Nothing reaches copias/ until the ZIP hashes as the platform
# expects and as its own sidecar declares; the sidecar is moved last.
cmd_package_fetch_internal() {
    local destination=$1 project=$2 source=$3 sha=$4 bucket=$5 region=$6 op_dir=$7 copias staging prefix line name size free actual
    [[ $project =~ $UUID_RE && $sha =~ $SHA_RE && $op_dir == "$OPS_DIR/"* ]] || exit 50
    load_destination "$destination" >/dev/null
    [[ ! -e $DST_RUNTIME_DIR/reports/destination-write.lock.json ]] || { echo "DESTINATION_ALREADY_WRITTEN" >&2; exit 51; }
    copias="$DST_RUNTIME_DIR/copias"
    [[ ! -L $copias ]] || exit 50
    mkdir -p "$op_dir/work"
    [[ -d $copias ]] || install -d -m 0755 "$copias"
    # The Consolidator, running as the profile's user, moves and extracts what lands here.
    [[ $(id -u) != 0 ]] || chown "$DST_RUN_AS:" "$copias"
    staging="$copias/.incoming-$(basename "$op_dir")"
    rm -rf -- "$staging"
    mkdir -m 0700 "$staging"
    # Expanded now: the trap runs after this function's locals are gone.
    # shellcheck disable=SC2064
    trap "rm -rf -- $(printf '%q' "$staging")" EXIT
    prefix="mwt/$project/$source/$sha"
    aws s3 cp "s3://$bucket/$prefix.zip.sha256" "$staging/sidecar" --region "$region" --only-show-errors \
        || { echo "SIDECAR_DOWNLOAD_FAILED" >&2; exit 52; }
    line=$(head -c 512 "$staging/sidecar" | head -n 1 | tr -d '\r')
    [[ $line =~ ^([0-9a-f]{64})\ [\ *]?([a-z][a-z0-9_-]{0,63}\.zip)$ && ${BASH_REMATCH[1]} == "$sha" ]] || { echo "SIDECAR_INVALID" >&2; exit 53; }
    name=${BASH_REMATCH[2]}
    if [[ -f $copias/$name && ! -L $copias/$name ]]; then
        # Same name already there: only the very same package counts as present.
        [[ $(sha256sum "$copias/$name" | cut -c1-64) == "$sha" ]] || { echo "DESTINATION_NAME_CONFLICT" >&2; exit 54; }
        cp "$staging/sidecar" "$copias/$name.sha256.tmp" && mv -f "$copias/$name.sha256.tmp" "$copias/$name.sha256"
        [[ $(id -u) != 0 ]] || chown "$DST_RUN_AS:" "$copias/$name" "$copias/$name.sha256"
        size=$(stat -c %s "$copias/$name")
        write_atomic "$op_dir/work/result.json" "$(printf '{"name":"%s","sha256":"%s","size":%s,"already_present":true,"fetched_at":"%s"}' "$name" "$sha" "$size" "$(now_utc)")"
        echo "FETCH_OK name=$name already_present=1"
        exit 0
    fi
    [[ ! -e $copias/$name ]] || { echo "DESTINATION_NAME_CONFLICT" >&2; exit 54; }
    size=$(aws s3api head-object --bucket "$bucket" --key "$prefix.zip" --region "$region" --query ContentLength --output text 2>/dev/null) || size=''
    [[ $size =~ ^[0-9]+$ ]] || { echo "PACKAGE_NOT_FOUND" >&2; exit 55; }
    free=$(df -PB1 "$copias" | awk 'NR==2 {print $4}')
    # The ZIP plus a tenth of margin; the Consolidator sizes its own extraction later.
    ((free > size + size / 10)) || { echo "INSUFFICIENT_DISK" >&2; exit 56; }
    aws s3 cp "s3://$bucket/$prefix.zip" "$staging/$name" --region "$region" --only-show-errors \
        || { echo "PACKAGE_DOWNLOAD_FAILED" >&2; exit 57; }
    actual=$(sha256sum "$staging/$name" | cut -c1-64)
    [[ $actual == "$sha" && $(stat -c %s "$staging/$name") == "$size" ]] || { echo "PACKAGE_HASH_MISMATCH" >&2; exit 58; }
    chmod 0644 "$staging/$name" "$staging/sidecar"
    [[ $(id -u) != 0 ]] || chown "$DST_RUN_AS:" "$staging/$name" "$staging/sidecar"
    mv "$staging/$name" "$copias/$name"
    mv "$staging/sidecar" "$copias/$name.sha256"
    write_atomic "$op_dir/work/result.json" "$(printf '{"name":"%s","sha256":"%s","size":%s,"already_present":false,"fetched_at":"%s"}' "$name" "$sha" "$size" "$(now_utc)")"
    echo "FETCH_OK name=$name already_present=0"
}

# Cleans a destination and prepares it again, as one operation: the Compose
# project and its volumes are removed, the runtime is restored from the verified
# tree keeping only the administrator's .env, and then the Consolidator's own
# `preparar` runs as the profile's user. Site packages already backed up in S3
# are not touched. Runs as root because the containers leave files of their own
# users inside the runtime.
cmd_destination_prepare_internal() {
    local destination=$1 distribution=$2 op_dir=$3 store runtime managed lock
    [[ $distribution =~ $SHA_RE && $op_dir == "$OPS_DIR/"* ]] || exit 80
    load_destination "$destination" >/dev/null
    [[ $DST_TOOL_TREE == "$distribution" ]] || exit 80
    store=$(compgen -G "$TOOLS_DIR/moodle-consolidador-*/$distribution" | head -n 1) || exit 80
    (($(unsafe_entries "$store") == 0)) && [[ $(tree_hash "$store") == "$distribution" ]] || { echo "TOOL_HASH_MISMATCH" >&2; exit 81; }
    runtime=$DST_RUNTIME_DIR
    # Only something that looks like a Consolidator runtime is ever emptied.
    [[ -d $runtime && ! -L $runtime && -f $runtime/.env && ! -L $runtime/.env && -f $runtime/FILES.sha256 && -f $runtime/moodle-consolidation.sh ]] \
        || { echo "DESTINATION_RUNTIME_MISSING" >&2; exit 82; }
    mkdir -p "$runtime/reports"
    exec {lock}>"$runtime/reports/assistant-run.lock"
    flock -n "$lock" || { echo "ASSISTANT_RUNNING" >&2; exit 61; }
    echo "DESTINATION_RESET_STARTED"
    if command -v docker >/dev/null 2>&1; then
        # shellcheck disable=SC2016
        runuser -u "$DST_RUN_AS" -- bash -c 'set -euo pipefail; cd "$1"
            socket=/var/run/docker.sock
            export ASSISTANT_PROJECT_ROOT="$1" ASSISTANT_UID="$(id -u)" ASSISTANT_GID="$(id -g)" DOCKER_SOCKET_PATH=$socket
            export DOCKER_GID="$(stat -c %g "$socket")" COMPOSE_PROJECT_NAME=moodle-consolidation-production
            set -a; . ./.env; set +a
            export MOODLE_MANAGED_CONFIG_DIR="${MOODLE_MANAGED_CONFIG_DIR:-$1/managed-config}"
            docker compose --project-name moodle-consolidation-production down -v --remove-orphans' destination-reset "$runtime" \
            || { echo "DESTINATION_SERVICES_NOT_REMOVED" >&2; exit 83; }
        echo "DESTINATION_SERVICES_REMOVED"
    fi
    managed=$(sed -n 's/^MOODLE_MANAGED_CONFIG_DIR=\(.*\)$/\1/p' "$runtime/.env" | head -n 1)
    find "$runtime" -mindepth 1 -maxdepth 1 ! -name .env -exec rm -rf -- {} +
    cp -a "$store/." "$runtime/"
    if [[ -z $managed || $managed == "$runtime/managed-config" ]]; then
        install -d -m 0700 "$runtime/managed-config"
    elif safe_path "$managed" && [[ -d $managed && ! -L $managed ]]; then
        # A managed configuration outside the runtime belongs to the old site as well.
        find "$managed" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    fi
    chown -R "$DST_RUN_AS:" "$runtime"
    [[ -z $managed || ! -d $managed ]] || chown -R "$DST_RUN_AS:" "$managed"
    chmod 0600 "$runtime/.env"
    engine_intact "$runtime" || { echo "ENGINE_NOT_RESTORED" >&2; exit 84; }
    echo "DESTINATION_RESET_DONE"
    flock -u "$lock"
    # shellcheck disable=SC2016
    exec runuser -u "$DST_RUN_AS" -- bash -c 'cd "$1" && exec bash ./moodle-consolidation.sh preparar' consolidator-prepare "$runtime"
}

# Uploads the Consolidator's sealed site package to the platform's bucket. The
# ZIP must hash as the platform reviewed and as the Consolidator's own summary
# declares; S3 receives the SHA-256 both as metadata and as its checksum.
cmd_site_upload_internal() {
    local destination=$1 project=$2 execution=$3 sha=$4 bucket=$5 region=$6 op_dir=$7 package summary declared actual size key
    [[ $project =~ $UUID_RE && $execution =~ $UUID_RE && $sha =~ $SHA_RE && $op_dir == "$OPS_DIR/"* ]] || exit 70
    load_destination "$destination" >/dev/null
    package="$DST_RUNTIME_DIR/exports/phase8/paquete-sitio-consolidado.zip"
    summary="$DST_RUNTIME_DIR/exports/phase8/site_package_summary.json"
    [[ -f $package && ! -L $package && -f $summary && ! -L $summary ]] || { echo "SITE_PACKAGE_MISSING" >&2; exit 71; }
    declared=$(sed -n 's/.*"package_sha256" *: *"\([0-9a-f]\{64\}\)".*/\1/p' "$summary" | head -n 1)
    [[ $declared == "$sha" ]] || { echo "SITE_SUMMARY_MISMATCH" >&2; exit 72; }
    actual=$(sha256sum "$package" | cut -c1-64)
    [[ $actual == "$sha" ]] || { echo "SITE_PACKAGE_HASH_MISMATCH" >&2; exit 73; }
    size=$(stat -c %s "$package")
    key="mwt/$project/consolidated/$execution/$sha.zip"
    mkdir -p "$op_dir/work"
    aws s3 cp "$package" "s3://$bucket/$key" --region "$region" --only-show-errors --sse AES256 --checksum-algorithm SHA256 \
        --metadata "mwt-sha256=$sha,mwt-project=$project,mwt-execution=$execution" || { echo "UPLOAD_FAILED" >&2; exit 74; }
    write_atomic "$op_dir/work/result.json" "$(printf '{"bucket":"%s","region":"%s","key":"%s","sha256":"%s","size":%s,"uploaded_at":"%s"}' \
        "$bucket" "$region" "$key" "$sha" "$size" "$(now_utc)")"
    echo "SITE_UPLOAD_OK"
}

