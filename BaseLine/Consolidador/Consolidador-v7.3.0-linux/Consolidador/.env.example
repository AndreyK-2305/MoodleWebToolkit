# Copie este archivo como .env mediante ./CONFIGURAR.sh.
# No use literalmente los valores CHANGE_ME.

MOODLE_PUBLIC_URL=https://moodle.example.edu
# Solo para comprobar el contenedor desde el mismo servidor. No es la URL
# del Moodle ni se guarda como destino de la consolidación.
MOODLE_INTERNAL_HEALTH_URL=http://127.0.0.1:8090
MOODLE_BIND_ADDRESS=127.0.0.1
MOODLE_HTTP_PORT=8090

MOODLE_SITE_NAME="Moodle consolidado"
MOODLE_SITE_SHORTNAME=CONSOLIDADO
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME
MOODLE_ADMIN_EMAIL=admin@example.edu

MOODLE_DB_NAME=moodle_target
MOODLE_DB_USER=moodle_target
MOODLE_DB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Referencia única usada por Compose y por el gestor de config.php para
# comprobar la imagen recién construida.
MOODLE_TARGET_IMAGE=moodle-consolidation-target:5.2.1-v7.2.1-rc4

# Para una URL HTTPS terminada por proxy inverso, ambos deben ser 1.
MOODLE_REVERSE_PROXY=1
MOODLE_SSL_PROXY=1

# Fuente declarativa persistente, fuera de los volúmenes Docker. Use una ruta
# absoluta sin espacios. CONFIGURAR.sh propone una dentro del despliegue.
MOODLE_MANAGED_CONFIG_DIR=/opt/moodle-consolidated/config

# Automatización del asistente.
CONSOLIDATION_AUTO_DELAY_SECONDS=15

# Notificaciones opcionales. Las credenciales se guardan codificadas en
# base64 dentro del .env protegido; no se incluyen en reportes ni paquetes.
CONSOLIDATION_EMAIL_ENABLED=0
CONSOLIDATION_EMAIL_TO=admin@example.edu
# Debe estar autorizado por el proveedor SMTP; no se deduce del administrador.
CONSOLIDATION_EMAIL_FROM=notificaciones@example.edu
CONSOLIDATION_EMAIL_FROM_NAME="Consolidador Moodle"
CONSOLIDATION_SMTP_HOST=smtp.example.edu
CONSOLIDATION_SMTP_PORT=587
CONSOLIDATION_SMTP_USE_TLS=1
CONSOLIDATION_SMTP_USERNAME_BASE64=
CONSOLIDATION_SMTP_PASSWORD_BASE64=
